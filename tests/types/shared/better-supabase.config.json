{
  "$schema": "../../../packages/better-supabase/schemas/config-v1.json",
  "plugins": {
    "timestamps": true,
    "softDelete": {
      "column": "archived_at"
    },
    "tenant": true,
    "actor": true
  },
  "database": {
    "source": {
      "snapshot": "../../../supabase/snapshot.json"
    },
    "buckets": {
      "customerLogos": {
        "path": "{organizationId}/{customerId}/logo/{version}.webp",
        "policy": "tenant",
        "fileSizeLimit": "5MiB",
        "allowedMimeTypes": ["image/png", "image/jpeg", "image/webp"]
      }
    },
    "topics": {
      "notifications": "organization:{organizationId}:notifications:{userId}",
      "customers": "organization:{organizationId}:customers"
    }
  },
  "gen": {
    "casing": "camel",
    "output": "generated.ts",
    "json": {
      "customers.metadata": {
        "type": "{ source?: string; tier?: 'free' | 'pro' }"
      }
    }
  },
  "auth": {
    "organization": {
      "column": "organization_id"
    }
  }
}
