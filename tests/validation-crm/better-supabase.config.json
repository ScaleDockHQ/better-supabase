{
  "$schema": "../../packages/better-supabase/schemas/config-v1.json",
  "source": {
    "snapshot": "snapshot.json"
  },
  "casing": "camel",
  "output": "src/generated.ts",
  "readSets": ["src/latency.ts", "src/customer-detail.ts"],
  "blocks": {
    "read-sets": {},
    "updated-at": {},
    "tenant": {},
    "access": {
      "mode": "adopt",
      "tables": {
        "roles": "public.roles",
        "permissions": "public.permissions",
        "rolePermissions": "public.role_permissions",
