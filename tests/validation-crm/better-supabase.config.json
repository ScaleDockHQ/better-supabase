      "columns": {
        "roles": {
          "tenant": "organization_id"
        }
      }
    },
    "organizations": {
      "mode": "adopt",
      "tables": {
        "organizations": "public.organizations"
      },
      "columns": {
        "organizations": {
          "createdBy": null,
          "deletedAt": null
        }
      }
    },
    "profiles": {
      "mode": "adopt",
      "tables": {
        "profiles": "public.profiles"
      },
      "columns": {
        "profiles": {
          "key": "user_id",
          "fullName": null,
          "avatar": null,
          "onboarding": null
        }
      }
    },
    "teams": {
      "mode": "adopt",
      "tables": {
        "teams": "public.teams",
        "members": "public.team_members"
      },
      "columns": {
        "teams": {
          "tenant": "organization_id"
        },
        "members": {
          "tenant": "organization_id"
        }
      }
    }
  }
}
