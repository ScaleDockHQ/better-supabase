    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@better-supabase/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "better-supabase": "workspace:*",
    "oxlint": "catalog:",
    "pg": "catalog:",
    "temporal-polyfill": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
