{
  "name": "@better-supabase/validation-presets",
  "private": true,
  "description": "Every named preset from better-supabase/preset, rendered and installed as one migration on the local stack, with its generated lib/blocks.ts typechecked.",
  "type": "module",
  "scripts": {
    "gen": "UPDATE_WIRING=1 vitest run src/presets.test.ts",
