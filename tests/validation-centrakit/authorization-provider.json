{
  "apiVersion": 1,
  "name": "centrakit-authz",
  "scopes": [
    {
      "name": "organization",
      "idType": "uuid"
    },
    {
      "name": "project",
      "idType": "uuid",
      "parent": "organization"
    }
  ],
  "tenantScope": "organization",
  "functions": {
    "idsWith": "centrakit.authz_{scope}_ids_with({permission})",
    "idsWithFor": "centrakit.authz_{scope}_ids_with_for({user}, {permission})",
    "isPlatform": "centrakit.authz_is_platform({permission})",
    "isPlatformFor": "centrakit.authz_is_platform_for({user}, {permission})",
    "memberIds": "centrakit.authz_{scope}_member_ids()",
    "memberIdsFor": "centrakit.authz_{scope}_member_ids_for({user})",
    "canAssign": "centrakit.authz_can_assign({tenant}, {role})",
    "canAssignFor": "centrakit.authz_can_assign_for({user}, {tenant}, {role})",
    "permissionsFor": "centrakit.authz_permissions_for({user}, {tenant})",
    "holdersOf": "centrakit.authz_organization_users_with({permission}, {tenant})",
    "actorMayWrite": "centrakit.authz_actor_may_write()"
  },
  "requires": [
    {
      "function": "centrakit.authz_organization_ids_with",
      "args": "text",
      "role": "authenticated"
    },
    {
      "function": "centrakit.authz_project_ids_with",
      "args": "text",
      "role": "authenticated"
    },
    {
      "function": "centrakit.authz_is_platform",
      "args": "text",
      "role": "authenticated"
    },
    {
      "function": "centrakit.authz_organization_member_ids",
      "role": "authenticated"
    },
    {
      "function": "centrakit.authz_can_assign",
      "args": "uuid, text",
      "role": "authenticated"
    },
    {
      "function": "centrakit.authz_actor_may_write",
      "role": "authenticated"
    },
    {
      "function": "centrakit.authz_organization_member_ids_for",
      "args": "uuid",
      "role": "supabase_auth_admin"
    }
  ],
  "permissions": [
