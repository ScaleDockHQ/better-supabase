  "operations": {},
  "memberships": [
    {
      "table": "centrakit.organization_users",
      "userColumn": "user_id",
      "scope": {
        "value": "organization"
      },
      "idColumn": "organization_id"
    },
    {
      "table": "centrakit.project_members",
      "userColumn": "user_id",
      "scope": {
        "value": "project"
      },
      "idColumn": "project_id"
    }
  ],
  "suspension": {
    "user": {
      "table": "centrakit.profiles",
      "id": "user_id",
      "disabledAt": "disabled_at"
    },
    "tenant": {
      "table": "centrakit.organizations",
      "id": "id",
      "disabledAt": "disabled_at"
    }
  },
  "roleSources": [
    {
      "table": "centrakit.organization_users",
      "role": {
        "column": "role_id",
        "through": {
          "table": "centrakit.roles",
          "id": "id",
          "column": "key"
        }
      }
    }
  ],
  "decidingColumns": [
    "centrakit.organization_users.role_id",
    "centrakit.user_roles.role_id",
    "centrakit.project_members.user_id",
    "centrakit.organizations.disabled_at",
    "centrakit.profiles.disabled_at"
  ],
  "delegation": {
    "scopes": {}
