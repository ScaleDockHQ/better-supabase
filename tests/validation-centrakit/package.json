{
  "name": "@better-supabase/validation-centrakit",
  "private": true,
  "description": "CentraKit's schema adopting every SaaS SQL module, against the local stack.",
  "type": "module",
  "scripts": {
    "doctor": "better-supabase doctor --ignore BS303",
    "lint": "oxlint",
    "sql:check": "better-supabase sql sync --check",
    "test": "vitest run",
    "transit": "true",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@better-supabase/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "better-supabase": "workspace:*",
    "oxlint": "catalog:",
    "pg": "catalog:",
    "temporal-polyfill": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
