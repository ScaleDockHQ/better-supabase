{
  "name": "@better-supabase/monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "analyze": "turbo run analyze",
    "audit:high": "pnpm audit --audit-level high",
    "better-supabase": "better-supabase",
    "boundaries": "turbo boundaries",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=better-supabase...",
    "changeset": "changeset",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck",
    "check:no-permdock": "node scripts/check-no-permdock.ts",
    "check:prose": "node scripts/check-prose.ts",
    "check:publish": "turbo run check:publish",
    "db:gen": "for p in apps/examples/* apps/examples/monorepo/* tests/validation-*; do if [ \"$p\" != tests/validation-centrakit ] && ls \"$p\"/better-supabase.config.* >/dev/null 2>&1; then better-supabase gen --cwd \"$p\" || exit 1; fi; done",
    "dev": "turbo run dev",
    "dev:cleanup": "portless prune",
    "dev:docs": "dotenv -e .env.development.local -e .env.local -- turbo run dev:portless --filter=docs",
    "dev:example": "dotenv -e .env.development.local -e .env.local -- turbo run dev:portless --filter=@better-supabase/example-nextjs",
    "dev:hosted": "dotenv -e .env.local -- turbo run dev:portless",
    "dev:portless": "dotenv -e .env.development.local -e .env.local -- turbo run dev:portless",
    "dev:www": "dotenv -e .env.development.local -e .env.local -- turbo run dev:portless --filter=marketing --filter=docs",
    "docs:drift": "node scripts/docs-drift.ts",
    "doctor": "turbo run doctor",
    "env:local": "node scripts/env-local.ts",
    "env:pull": "vercel env pull .env.local --environment=development --yes",
    "env:pull:production": "vercel env pull .env.production.local --environment=production --yes",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "gen:check": "turbo run gen:check",
    "knip": "knip --config knip.mts",
    "lint": "turbo run lint lint:root",
    "lint:root": "oxlint -c oxlint.config.ts commitlint.config.ts knip.mts oxlint.config.ts oxfmt.config.ts vitest.config.ts scripts",
    "prepare": "node scripts/prepare.ts",
    "release": "pnpm run build && changeset publish",
    "size": "turbo run test --filter=@better-supabase/bundle",
    "supabase:reset": "supabase db reset",
    "supabase:signing-key": "better-supabase keys --cwd .",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:sync": "supabase db schema declarative sync --no-apply --strict-coverage -f",
    "supabase:test": "supabase test db",
    "supabase:types": "supabase gen types typescript --local --schema public",
    "test": "turbo run test",
    "test:integration": "pnpm --filter better-supabase exec vitest run --project integration && pnpm --filter @better-supabase/validation-centrakit test",
    "typecheck": "turbo run typecheck",
    "typecheck:matrix": "turbo run typecheck:matrix",
    "typecheck:perf": "turbo run typecheck:perf",
    "typecheck:tooling": "tsc --noEmit -p tsconfig.json",
    "verify": "pnpm run format:check && turbo run lint lint:root typecheck typecheck:tooling test check:prose check:no-permdock docs:drift knip gen:check doctor check:publish typecheck:matrix && turbo run typecheck:perf && turbo boundaries && pnpm run audit:high",
    "version-packages": "node scripts/root-changelog.ts && changeset version && node scripts/sync-versions.ts && pnpm run format"
  },
  "devDependencies": {
    "@better-supabase/ox-config": "workspace:*",
    "@better-supabase/typescript-config": "workspace:*",
    "@changesets/assemble-release-plan": "catalog:",
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@changesets/config": "catalog:",
    "@changesets/pre": "catalog:",
    "@changesets/read": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/types": "catalog:",
    "@manypkg/get-packages": "catalog:",
    "@types/node": "catalog:",
    "better-supabase": "workspace:*",
    "dotenv-cli": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "portless": "catalog:",
    "supabase": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "valibot": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "24.x",
    "pnpm": "12.8.1"
  },
  "packageManager": "pnpm@12.8.1"
}
