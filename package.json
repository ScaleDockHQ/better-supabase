{
  "name": "@better-supabase/monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "analyze": "turbo run analyze",
    "audit:high": "pnpm audit --audit-level high",
    "better-supabase": "better-supabase",
    "boundaries": "turbo boundaries",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=@better-supabase/cli...",
    "changeset": "changeset",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck",
    "check:prose": "node scripts/check-prose.ts",
    "check:publish": "turbo run check:publish",
    "db:gen": "for p in apps/examples/* tests/validation-*; do better-supabase gen --cwd \"$p\" || exit 1; done",
    "dev": "turbo run dev",
    "dev:cleanup": "portless prune",
    "dev:docs": "dotenv -e .env.development.local -e .env.local -- turbo run dev:portless --filter=docs",
    "dev:example": "dotenv -e .env.development.local -e .env.local -- turbo run dev:portless --filter=@better-supabase/example-nextjs",
    "dev:hosted": "dotenv -e .env.local -- turbo run dev:portless",
    "dev:portless": "dotenv -e .env.development.local -e .env.local -- turbo run dev:portless",
    "dev:www": "dotenv -e .env.development.local -e .env.local -- turbo run dev:portless --filter=marketing --filter=docs",
    "docs:drift": "node scripts/docs-drift.ts && pnpm --filter @better-supabase/cli exec vitest run --project unit tests/docs-drift.test.ts",
    "doctor": "better-supabase doctor --cwd apps/examples/nextjs",
    "env:local": "node scripts/env-local.ts",
    "env:pull": "vercel env pull .env.local --environment=development --yes",
    "env:pull:production": "vercel env pull .env.production.local --environment=production --yes",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "gen:check": "for p in apps/examples/* tests/validation-*; do better-supabase gen --check --cwd \"$p\" || exit 1; done",
    "knip": "knip --config knip.mts",
    "lint": "turbo run lint lint:root",
    "lint:root": "oxlint -c oxlint.config.ts commitlint.config.ts knip.mts oxlint.config.ts oxfmt.config.ts vitest.config.ts scripts",
    "prepare": "node scripts/prepare.ts",
    "release": "pnpm run build && changeset publish",
    "size": "pnpm --filter @better-supabase/bundle test",
    "supabase:diff": "supabase db diff -f",
    "supabase:reset": "supabase db reset",
    "supabase:signing-key": "better-supabase keys --cwd .",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:test": "supabase test db",
    "supabase:types": "supabase gen types typescript --local --schema public",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @better-supabase/e2e test:e2e",
    "test:integration": "pnpm --filter better-supabase --filter @better-supabase/cli exec vitest run --project integration",
    "typecheck": "turbo run typecheck",
    "typecheck:matrix": "pnpm --filter './tests/types/*' run typecheck:matrix",
    "typecheck:perf": "pnpm --filter @better-supabase/types-perf run bench",
    "typecheck:tooling": "tsc --noEmit -p tsconfig.json",
    "verify": "pnpm run check && pnpm run check:prose && pnpm run docs:drift && pnpm run typecheck:tooling && pnpm run knip && pnpm run boundaries && pnpm run test && pnpm run build:packages && pnpm run gen:check && pnpm run doctor && pnpm run check:publish && pnpm run size && pnpm run typecheck:matrix && pnpm run typecheck:perf && pnpm run audit:high",
    "version-packages": "node scripts/root-changelog.ts && changeset version && pnpm run format"
  },
  "devDependencies": {
    "@better-supabase/cli": "workspace:*",
    "@better-supabase/ox-config": "workspace:*",
    "@better-supabase/typescript-config": "workspace:*",
    "@changesets/assemble-release-plan": "catalog:",
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@changesets/config": "catalog:",
    "@changesets/pre": "catalog:",
    "@changesets/read": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/types": "catalog:",
    "@manypkg/get-packages": "catalog:",
    "@types/node": "catalog:",
    "dotenv-cli": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "portless": "catalog:",
    "supabase": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "valibot": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "24.x",
    "pnpm": "12.8.1"
  },
  "packageManager": "pnpm@12.8.1"
}
