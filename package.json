{
  "name": "@better-supabase/monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "audit:high": "pnpm audit --audit-level high",
    "better-supabase": "better-supabase",
    "boundaries": "turbo boundaries",
    "build": "turbo run build",
    "changeset": "changeset",
    "check:prose": "node scripts/check-prose.ts",
    "check:publish": "turbo run check:publish",
    "db:gen": "for p in apps/examples/* tests/validation-*; do better-supabase gen --cwd \"$p\" || exit 1; done",
    "dev": "turbo run dev",
    "dev:cleanup": "portless prune",
    "dev:portless": "dotenv -e .env.local -e .env.development.local -- turbo run dev:portless",
    "docs:dev": "turbo run dev --filter=docs",
    "doctor": "better-supabase doctor --cwd apps/examples/nextjs",
    "env:pull": "vercel env pull .env.development.local --environment=development --yes && vercel env pull .env.preview.local --environment=preview --yes && vercel env pull .env.production.local --environment=production --yes",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "turbo run lint && pnpm run lint:root",
    "lint:root": "oxlint -c oxlint.config.ts commitlint.config.ts oxlint.config.ts oxfmt.config.ts scripts",
    "prepare": "node scripts/prepare.mjs",
    "release": "pnpm run build && changeset publish",
    "site:dev": "turbo run dev --filter=docs --filter=marketing",
    "size": "pnpm --filter @better-supabase/bundle test",
    "supabase:diff": "supabase db diff -f",
    "supabase:reset": "supabase db reset",
    "supabase:signing-key": "better-supabase keys --cwd .",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:test": "supabase test db",
    "supabase:types": "supabase gen types typescript --local --schema public",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @better-supabase/e2e test:e2e",
    "test:integration": "pnpm --filter better-supabase exec vitest run --project integration",
    "typecheck": "turbo run typecheck",
    "typecheck:matrix": "pnpm --filter './tests/types/*' run typecheck:matrix",
    "typecheck:perf": "pnpm --filter @better-supabase/types-perf run bench",
    "typecheck:tooling": "tsc --noEmit -p tsconfig.json",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run check:prose && pnpm run typecheck && pnpm run typecheck:tooling && pnpm run boundaries && pnpm run test && pnpm run doctor && pnpm run audit:high",
    "version-packages": "changeset version && pnpm run format"
  },
  "devDependencies": {
    "@better-supabase/ox-config": "workspace:*",
    "@better-supabase/typescript-config": "workspace:*",
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/types": "catalog:",
    "@types/node": "catalog:",
    "better-supabase": "workspace:*",
    "dotenv-cli": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "portless": "catalog:",
    "supabase": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "24.x",
    "pnpm": "12.8.1"
  },
  "packageManager": "pnpm@12.8.1"
}
