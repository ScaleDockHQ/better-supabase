{
  "name": "@better-supabase/monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "analyze": "turbo run analyze",
    "audit:high": "pnpm audit --audit-level high",
    "better-supabase": "node packages/better-supabase/bin/better-supabase.js",
    "boundaries": "turbo boundaries",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=better-supabase...",
    "catalog": "node scripts/build-catalog.ts",
    "catalog:check": "node scripts/build-catalog.ts --check",
    "changeset": "changeset",
    "check": "ultracite check",
    "check:no-permdock": "node scripts/check-no-permdock.ts",
    "check:prose": "node scripts/check-prose.ts",
    "check:publish": "turbo run check:publish",
    "db:gen": "dotenv -e .env.development.local -- sh -c 'for p in apps/examples/* apps/examples/monorepo/* tests/validation-*; do if [ \"$p\" != tests/validation-centrakit ] && ls \"$p\"/better-supabase.config.* >/dev/null 2>&1; then node packages/better-supabase/bin/better-supabase.js gen --cwd \"$p\" || exit 1; fi; done'",
    "dev": "turbo run dev",
    "dev:cleanup": "portless prune",
    "dev:docs": "dotenv -e .env.development.local -e .env.local -- turbo run dev:portless --filter=docs",
    "dev:example": "dotenv -e .env.development.local -e .env.local -- turbo run dev:portless --filter=@better-supabase/example-nextjs",
    "dev:hosted": "dotenv -e .env.local -- turbo run dev:portless",
    "dev:portless": "dotenv -e .env.development.local -e .env.local -- turbo run dev:portless",
    "dev:www": "dotenv -e .env.development.local -e .env.local -- turbo run dev:portless --filter=marketing --filter=docs",
    "docs:drift": "node scripts/docs-drift.ts",
    "doctor": "turbo run doctor",
    "env:local": "node scripts/env-local.ts",
    "env:pull": "vercel env pull .env.local --environment=development --yes",
    "env:pull:production": "vercel env pull .env.production.local --environment=production --yes",
    "fix": "ultracite fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "gate": "TURBO_SCM_BASE=${TURBO_SCM_BASE:-origin/main} turbo run lint lint:root typecheck --affected --cache=local:rw,remote:r --output-logs=errors-only --continue=dependencies-successful",
    "gen:check": "turbo run gen:check",
    "knip": "knip --config knip.mts --cache",
    "lint": "turbo run lint lint:root",
    "lint:root": "oxlint -c oxlint.config.ts commitlint.config.ts knip.mts oxlint.config.ts oxfmt.config.ts vitest.config.ts scripts",
    "prepare": "node scripts/prepare.ts",
    "recipes": "node scripts/build-recipes.ts --write",
    "recipes:check": "node scripts/build-recipes.ts --check",
    "registry:build": "pnpm --filter @better-supabase/registry registry:build",
    "release": "pnpm run build && changeset publish",
    "screenshots:recipes": "RECIPE_SCREENSHOTS=1 pnpm --filter @better-supabase/example-nextjs exec playwright test recipe-screenshots && pnpm recipes",
    "size": "turbo run test --filter=@better-supabase/bundle",
    "supabase:diff": "supabase db schema declarative sync --no-apply --strict-coverage -f",
    "supabase:prune": "node scripts/supabase-prune.ts",
    "supabase:reset": "supabase db reset",
    "supabase:signing-key": "node packages/better-supabase/bin/better-supabase.js dev keys --cwd .",
    "supabase:start": "supabase start --runtime native && pnpm env:local",
    "supabase:stop": "supabase stop",
    "supabase:test": "supabase test db",
    "supabase:types": "supabase gen types typescript --local --schema public,graphql_public",
    "test": "turbo run test",
    "test:integration": "dotenv -e .env.development.local -- sh -c \"pnpm --filter better-supabase exec vitest run --project integration && pnpm --filter @better-supabase/validation-centrakit test && pnpm --filter @better-supabase/validation-recipes test && pnpm --filter @better-supabase/validation-presets test\"",
    "test:scripts": "vitest run --config scripts/vitest.config.ts",
    "typecheck": "turbo run typecheck",
    "typecheck:matrix": "turbo run typecheck:matrix",
    "typecheck:perf": "turbo run typecheck:perf",
    "typecheck:tooling": "tsc --noEmit -p tsconfig.json",
    "verify": "turbo run format:check audit:high lint lint:root typecheck typecheck:tooling test test:scripts check:prose check:no-permdock recipes:check catalog:check docs:drift knip gen:check doctor check:publish typecheck:matrix && turbo run typecheck:perf && turbo boundaries",
    "version-packages": "node scripts/root-changelog.ts && changeset version && node scripts/sync-versions.ts && pnpm run registry:build && pnpm run format"
  },
  "devDependencies": {
    "@better-supabase/typescript-config": "workspace:*",
    "@changesets/assemble-release-plan": "catalog:",
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@changesets/config": "catalog:",
    "@changesets/pre": "catalog:",
    "@changesets/read": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/types": "catalog:",
    "@manypkg/get-packages": "catalog:",
    "@shadcn/lint": "catalog:",
    "@types/node": "catalog:",
    "dotenv-cli": "catalog:",
    "eslint-plugin-playwright": "catalog:",
    "eslint-plugin-turbo": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-plugin-react-doctor": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "portless": "catalog:",
    "supabase": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "valibot": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "24.x",
    "pnpm": "12.14.0"
  },
  "packageManager": "pnpm@12.14.0"
}
