    "member": "A tenant membership.",
    "user": "A row in `auth.users`.",
    "actor": "Whoever runs a statement.",
    "block": "A feature module, installed as an instance.",
    "module": "A generated SQL file.",
    "app file": "A SQL file the app owns."
