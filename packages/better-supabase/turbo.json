{
  "$schema": "https://v2-11-7.turborepo.dev/schema.json",
  "extends": ["//"],
  "tags": ["published"],
  "tasks": {
    "test": {
      "passThroughEnv": ["BS_TOML_SITE_URL", "DATABASE_URL"],
      "dependsOn": ["$TURBO_EXTENDS$", "build"],
      "outputs": [".vitest/blob/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/registry/registry.json",
        "$TURBO_ROOT$/apps/marketing/public/r/**",
        "$TURBO_ROOT$/apps/docs/content/docs/frameworks/**"
      ]
    }
  }
}
