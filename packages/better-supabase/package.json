{
  "name": "better-supabase",
  "version": "0.1.0",
  "description": "Strongly typed Supabase: generated schema, typed repositories, plugins, auth glue and framework integrations, with a CLI from day one.",
  "keywords": [
    "hono",
    "mcp",
    "nextjs",
    "openapi",
    "opentelemetry",
    "postgres",
    "postgrest",
    "rls",
    "supabase",
    "tanstack-query",
    "typescript"
  ],
  "homepage": "https://bettersupabase.com",
  "bugs": {
    "url": "https://github.com/ScaleDockHQ/better-supabase/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ScaleDockHQ/better-supabase.git",
    "directory": "packages/better-supabase"
  },
  "bin": {
    "better-supabase": "./bin/better-supabase.js"
  },
  "files": [
    "bin",
    "dist",
    "schemas",
    "skills",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "react-server": "./dist/react/server.js",
      "default": "./dist/react/index.js"
    },
    "./query": {
      "types": "./dist/query/index.d.ts",
      "default": "./dist/query/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres/index.d.ts",
      "default": "./dist/postgres/index.js"
    },
    "./ssr": {
      "types": "./dist/ssr/index.d.ts",
      "default": "./dist/ssr/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "default": "./dist/next/index.js"
    },
    "./next/image": {
      "types": "./dist/next/image/index.d.ts",
      "default": "./dist/next/image/index.js"
    },
    "./hono": {
      "types": "./dist/hono/index.d.ts",
      "default": "./dist/hono/index.js"
    },
    "./orpc": {
      "types": "./dist/orpc/index.d.ts",
      "default": "./dist/orpc/index.js"
    },
    "./edge": {
      "types": "./dist/edge/index.d.ts",
      "default": "./dist/edge/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/mcp/index.js"
    },
    "./jobs": {
      "types": "./dist/jobs/index.d.ts",
      "default": "./dist/jobs/index.js"
    },
    "./env": {
      "types": "./dist/env/index.d.ts",
      "default": "./dist/env/index.js"
    },
    "./list": {
      "types": "./dist/list/index.d.ts",
      "default": "./dist/list/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "default": "./dist/storage/index.js"
    },
    "./realtime": {
      "types": "./dist/realtime/index.d.ts",
      "default": "./dist/realtime/index.js"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "default": "./dist/events/index.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks/index.d.ts",
      "default": "./dist/webhooks/index.js"
    },
    "./openapi": {
      "types": "./dist/openapi/index.d.ts",
      "default": "./dist/openapi/index.js"
    },
    "./otel": {
      "types": "./dist/otel/index.d.ts",
      "default": "./dist/otel/index.js"
    },
    "./plugins/timestamps": {
      "types": "./dist/plugins/timestamps/index.d.ts",
      "default": "./dist/plugins/timestamps/index.js"
    },
    "./lint": {
      "types": "./dist/lint/index.d.ts",
      "default": "./dist/lint/index.js"
    },
    "./plugins/rules": {
      "types": "./dist/plugins/rules/index.d.ts",
      "default": "./dist/plugins/rules/index.js"
    },
    "./plugins/soft-delete": {
      "types": "./dist/plugins/soft-delete/index.d.ts",
      "default": "./dist/plugins/soft-delete/index.js"
    },
    "./plugins/tenant": {
      "types": "./dist/plugins/tenant/index.d.ts",
      "default": "./dist/plugins/tenant/index.js"
    },
    "./plugins/actor": {
      "types": "./dist/plugins/actor/index.d.ts",
      "default": "./dist/plugins/actor/index.js"
    },
    "./plugins/validation": {
      "types": "./dist/plugins/validation/index.d.ts",
      "default": "./dist/plugins/validation/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    },
    "./schemas/*.json": "./schemas/*.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "bench": "node src/next/next.bench.ts",
    "build": "tsdown",
    "check:publish": "publint && pnpm pack --out pack.tgz && attw --profile esm-only pack.tgz && rm -f pack.tgz",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit --checkers 4"
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:",
    "@supabase/middleware": "catalog:",
    "@supabase/postgrest-typegen": "catalog:",
    "@supabase/server": "catalog:",
    "@supabase/ssr": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@better-supabase/typescript-config": "workspace:*",
