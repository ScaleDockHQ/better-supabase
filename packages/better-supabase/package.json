    "zod": "catalog:"
  },
  "peerDependencies": {
    "@opentelemetry/api": "catalog:peers",
    "@orpc/server": "catalog:peers",
    "@supabase/config": "catalog:peers",
    "@supabase/supabase-js": "catalog:peers",
    "@tanstack/query-core": "catalog:peers",
    "hono": "catalog:peers",
