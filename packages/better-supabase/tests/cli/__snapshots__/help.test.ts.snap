exports[`help > documents codemod 1`] = `
"Usage: better-supabase codemod <command> [options]

Rewrites imports, calls and config keys for renamed better-supabase APIs

Commands
  0.4   Renames from 0.3 to 0.4
  0.5   Renames from 0.4 to 0.5
  0.6   Changes from 0.5 to 0.6: kits become blocks and modules
  0.9   Changes from 0.8 to 0.9: sql.modules becomes blocks, and CLI calls use the new subcommands and flags
  0.11  Changes from 0.10 to 0.11: adopted outgoing webhooks get an explicit defaultFormat
  0.15  Changes from 0.14 to 0.15: the runtime instance bs becomes bsb, exports take their block, record and provider names, the config regroups, renamed blocks take their 0.15 names, and CLI calls use the new commands
  0.29  Changes from 0.28 to 0.29: records is renamed back to subjects in the config, and record tags in the schema files become subject tags
  0.32  Changes from 0.31 to 0.32: tenant is the public word again (auth.tenant, requireTenant), and sign-in, session, proxy and cache names follow supabase-js
  0.35  The 0.36 part of the 0.35 to 0.37 changes, as 0.36.0 shipped it: the proxy refreshes on every request, session cookies go through @supabase/ssr, and the cookie codec and prefetch predicates are gone. Prefer codemod 0.37
  0.37  Changes from 0.35 to 0.37: the proxy refreshes on every request, session cookies go through @supabase/ssr, the cookie codec and prefetch predicates are gone, and stock quantities are numeric

Global options
  --cwd <dir>            Project directory
  --config <file>        Config file, relative to --cwd
  --env <name>           Config environment to apply ($env.<name> or $<name>). Defaults to $BETTER_SUPABASE_ENV, then ci when $CI is set
  --json                 Print one JSON document on stdout; errors as Problem Details. On by default in agent mode
  --agent <auto|yes|no>  Agent mode (JSON output, no prompts, consent for destructive work): auto detects a coding agent, yes or no decide. Defaults to $BETTER_SUPABASE_AGENT, then auto
  --confirm <token>      The token from a consent_required result, passed once the user agreed
  -y, --yes              Ask nothing; use the flags and the defaults
  --no-color             Print no colors, like $NO_COLOR
  --debug                Print stack traces, the commands the CLI runs, and timings on stderr
  -h, --help             Show help

Docs: https://bettersupabase.com/docs/cli/codemod
"
`;

exports[`help > documents completion 1`] = `
"Usage: better-supabase completion [options] [shell]

Prints the shell completion script for bash, zsh or fish, for both better-supabase and bsb

Arguments
  [shell]  bash, zsh, fish

Global options
  --cwd <dir>            Project directory
  --config <file>        Config file, relative to --cwd
  --env <name>           Config environment to apply ($env.<name> or $<name>). Defaults to $BETTER_SUPABASE_ENV, then ci when $CI is set
  --json                 Print one JSON document on stdout; errors as Problem Details. On by default in agent mode
  --agent <auto|yes|no>  Agent mode (JSON output, no prompts, consent for destructive work): auto detects a coding agent, yes or no decide. Defaults to $BETTER_SUPABASE_AGENT, then auto
  --confirm <token>      The token from a consent_required result, passed once the user agreed
  -y, --yes              Ask nothing; use the flags and the defaults
  --no-color             Print no colors, like $NO_COLOR
  --debug                Print stack traces, the commands the CLI runs, and timings on stderr
  -h, --help             Show help

Examples
  # Turns on completion in the current zsh; add it to ~/.zshrc
  $ eval "$(better-supabase completion zsh)"

Side effects: None.
Docs: https://bettersupabase.com/docs/cli/completion
"
`;

exports[`help > documents config 1`] = `
"Usage: better-supabase config [options]

Prints the resolved config: the file it came from, the active environment and every option with its default, or the preset it names with --preset

Options
  --preset  The preset the config names, what it resolves to, and how the config differs from it

Global options
  --cwd <dir>            Project directory
  --config <file>        Config file, relative to --cwd
  --env <name>           Config environment to apply ($env.<name> or $<name>). Defaults to $BETTER_SUPABASE_ENV, then ci when $CI is set
  --json                 Print one JSON document on stdout; errors as Problem Details. On by default in agent mode
  --agent <auto|yes|no>  Agent mode (JSON output, no prompts, consent for destructive work): auto detects a coding agent, yes or no decide. Defaults to $BETTER_SUPABASE_AGENT, then auto
  --confirm <token>      The token from a consent_required result, passed once the user agreed
  -y, --yes              Ask nothing; use the flags and the defaults
  --no-color             Print no colors, like $NO_COLOR
  --debug                Print stack traces, the commands the CLI runs, and timings on stderr
  -h, --help             Show help

Side effects: None.
Docs: https://bettersupabase.com/docs/cli/config#print-the-resolved-config
"
`;

exports[`help > documents db 1`] = `
"Usage: better-supabase db <command> [options]

Runs SQL files and seeds against the database, backfills columns, prunes ended workflow runs, and diffs the declarative schema: the local stack by default, or the one in the connection string

Commands
  query            Runs each file as one multi-statement script, in order, optionally in a single transaction
  diff             Turns the declarative schema into a migration, diffing inside the running stack when the shadow database can't start
  seed             Renders the fixtures from defineSeed() (better-supabase/testing) to SQL, and runs them with --apply
  backfill         Fills the null values of a column in batches, from the table a foreign key references or from a literal
  prune-workflows  Deletes ended Workflow SDK runs, with their events, steps, streams and hooks, in batches

Global options
  --cwd <dir>            Project directory
  --config <file>        Config file, relative to --cwd
  --env <name>           Config environment to apply ($env.<name> or $<name>). Defaults to $BETTER_SUPABASE_ENV, then ci when $CI is set
  --json                 Print one JSON document on stdout; errors as Problem Details. On by default in agent mode
  --agent <auto|yes|no>  Agent mode (JSON output, no prompts, consent for destructive work): auto detects a coding agent, yes or no decide. Defaults to $BETTER_SUPABASE_AGENT, then auto
  --confirm <token>      The token from a consent_required result, passed once the user agreed
  -y, --yes              Ask nothing; use the flags and the defaults
  --no-color             Print no colors, like $NO_COLOR
  --debug                Print stack traces, the commands the CLI runs, and timings on stderr
  -h, --help             Show help

Docs: https://bettersupabase.com/docs/cli/db
"
`;

exports[`help > documents db backfill 1`] = `
"Usage: better-supabase db backfill [options] <column...>

Fills the null values of a column in batches, from the table a foreign key references or from a literal

Arguments
  <column...>  The column to fill, as table.column or schema.table.column; \`via <column>\` after it names the foreign key --from follows

Options
  --from <table.column>  Copy the value from this column of the table the foreign key references (table.column or schema.table.column)
  --via <column>         The foreign key column of the filled table that points at the --from table
  --value <literal>      Set this SQL literal instead: a quoted string with an optional cast, a number, true or false
  --batch-size <n>       Rows to update per statement (default 1000)
  --dry-run              Count the rows it would fill, and change nothing
  --db-url-stdin         Read the connection string from stdin instead of the config, $DATABASE_URL or $SUPABASE_DB_URL
  --stack <name>         Use the stack in supabase/stacks/<name>/config.toml (default $BSB_STACK) instead of the default local stack

Global options
  --cwd <dir>            Project directory
  --config <file>        Config file, relative to --cwd
  --env <name>           Config environment to apply ($env.<name> or $<name>). Defaults to $BETTER_SUPABASE_ENV, then ci when $CI is set
  --json                 Print one JSON document on stdout; errors as Problem Details. On by default in agent mode
  --agent <auto|yes|no>  Agent mode (JSON output, no prompts, consent for destructive work): auto detects a coding agent, yes or no decide. Defaults to $BETTER_SUPABASE_AGENT, then auto
  --confirm <token>      The token from a consent_required result, passed once the user agreed
  -y, --yes              Ask nothing; use the flags and the defaults
  --no-color             Print no colors, like $NO_COLOR
  --debug                Print stack traces, the commands the CLI runs, and timings on stderr
  -h, --help             Show help

Examples
  # Copies each invoice's organization from its project, where it is still null
  $ better-supabase db backfill invoices.organization_id --from projects.organization_id via project_id
  # Counts the rows it would set to EUR
  $ better-supabase db backfill invoices.currency --value "'EUR'" --dry-run

Side effects: Writes to the database.
Docs: https://bettersupabase.com/docs/cli/db#backfill
"
`;

exports[`help > documents db diff 1`] = `
"Usage: better-supabase db diff [options]

Turns the declarative schema into a migration, diffing inside the running stack when the shadow database can't start

Options
  -f, --file <name>  Save the diff as supabase/migrations/<timestamp>_<name>.sql instead of printing it
  --in-stack         Diff inside the running stack with pg-delta's library plan, without the Supabase CLI's shadow database
  --allow-data-loss  Write the migration even when it drops tables or columns, or changes a column type
  --stack <name>     Use the stack in supabase/stacks/<name>/config.toml (default $BSB_STACK) instead of the default local stack

Global options
  --cwd <dir>            Project directory
  --config <file>        Config file, relative to --cwd
  --env <name>           Config environment to apply ($env.<name> or $<name>). Defaults to $BETTER_SUPABASE_ENV, then ci when $CI is set
  --json                 Print one JSON document on stdout; errors as Problem Details. On by default in agent mode
  --agent <auto|yes|no>  Agent mode (JSON output, no prompts, consent for destructive work): auto detects a coding agent, yes or no decide. Defaults to $BETTER_SUPABASE_AGENT, then auto
  --confirm <token>      The token from a consent_required result, passed once the user agreed
  -y, --yes              Ask nothing; use the flags and the defaults
  --no-color             Print no colors, like $NO_COLOR
  --debug                Print stack traces, the commands the CLI runs, and timings on stderr
  -h, --help             Show help

Examples
  # Save the diff as a migration, falling back to the running stack
  $ better-supabase db diff -f add_invoices
  # Print the diff without starting a shadow database
  $ better-supabase db diff --in-stack

Side effects: Writes to the database, writes files with --file.
Docs: https://bettersupabase.com/docs/cli/db#diff
"
`;

exports[`help > documents db prune-workflows 1`] = `
"Usage: better-supabase db prune-workflows [options]

Deletes ended Workflow SDK runs, with their events, steps, streams and hooks, in batches

Options
  --older-than <age>  Delete runs that ended longer ago than this: 30d, 12h, or a Postgres interval (default 30d)
  --status <list>     The ended statuses to delete, comma-separated (default completed,failed,cancelled)
  --batch-size <n>    Runs to delete per statement, 1 to 10000 (default 500)
  --dry-run           Count the runs it would delete, and change nothing
  --db-url-stdin      Read the connection string from stdin instead of the config, $DATABASE_URL or $SUPABASE_DB_URL
  --stack <name>      Use the stack in supabase/stacks/<name>/config.toml (default $BSB_STACK) instead of the default local stack

Global options
  --cwd <dir>            Project directory
  --config <file>        Config file, relative to --cwd
  --env <name>           Config environment to apply ($env.<name> or $<name>). Defaults to $BETTER_SUPABASE_ENV, then ci when $CI is set
  --json                 Print one JSON document on stdout; errors as Problem Details. On by default in agent mode
  --agent <auto|yes|no>  Agent mode (JSON output, no prompts, consent for destructive work): auto detects a coding agent, yes or no decide. Defaults to $BETTER_SUPABASE_AGENT, then auto
  --confirm <token>      The token from a consent_required result, passed once the user agreed
  -y, --yes              Ask nothing; use the flags and the defaults
  --no-color             Print no colors, like $NO_COLOR
  --debug                Print stack traces, the commands the CLI runs, and timings on stderr
  -h, --help             Show help

Examples
  # Deletes completed, failed and cancelled runs older than 30 days
  $ better-supabase db prune-workflows --older-than 30d
  # Counts the failed runs it would delete
  $ better-supabase db prune-workflows --older-than 7d --status failed --dry-run

Side effects: Writes to the database.
Docs: https://bettersupabase.com/docs/cli/db#prune-workflows
"
`;

exports[`help > documents db query 1`] = `
