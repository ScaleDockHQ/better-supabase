// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`help > documents add 1`] = `
"Usage: better-supabase add [options] [block...]

Adds blocks with what they require, a preset with --preset, existing tables with --adopt, or glue for an integration with --integration

Arguments
  [block...]  Blocks to install with what they require (\`better-supabase blocks list\`). Without blocks or --integration, sets up the integrations in the config that have no files yet

Options
  --integration <integration,...>           Adds glue for integrations instead: next, hono, orpc, edge, expo, mcp, client or react
  --force                                   Overwrite files that exist
  --allow-hook-overlap                      With blocks: write modules whose claim the authorization provider's hook already writes
  --tests-dir <dir>                         With blocks: where the pgtap module goes. Defaults to database.sql.testsDir
  --over <schema.table,...>                 Install one block over tables you already have, as table or schema.table. Shorthand for --adopt --tables
  --preset <name|code|url|file>             A named preset, a design code from /create, its URL or a downloaded design file; the design sets the preset and adds its app tables and extra columns
  --package <dir>                           Workspace package whose config to edit, relative to --cwd; a Create URL's package= sets it too
  --only <blocks|conventions>               blocks: add the preset's blocks to blocks and leave the conventions; conventions: take the conventions and no blocks
  --adopt                                   Map existing tables onto a block (with --tables), the preset's blocks onto tables under their default names, or, alone, write the data rows migration for blocks over your tables
  --dry-run                                 Print what would change, with a diff, and write nothing
  --check                                   Write nothing; exit 1 with a diff when a file would change
  --tables <schema.table,...>               The existing tables, as table or schema.table; the block's other tables are looked up by their default names
  --casing <snake|camel>                    Row keys: snake keeps the database's names (the default), camel renames them in the query
  --scope <tenant|user|none>                Row ownership (database.sql.owner): tenant (the default), user or none for one shared space
  --tenant-name <name>                      What a tenant is called (blocks.memberships.names.organization): organization (the default), workspace, team or another lowercase name
  --access <roles|catalog|provider|custom>  Auth and permissions (blocks.permissions.model): roles (the default), catalog, provider or custom
  --id-type <uuid|text|bigint|integer>      The type of the permissions block's ids (blocks.permissions.idType): uuid (the default), text, bigint or integer
  --api <none|api>                          API schema (database.sql.api): none (the default) or api for security invoker wrappers in an api schema
  --snapshot <file>                         Read a saved snapshot instead of the database
  --db-url-stdin                            Read the connection string from stdin instead of the config, $DATABASE_URL or $SUPABASE_DB_URL
  --project-ref <ref>                       Read a hosted project through the Management API

Global options
  --cwd <dir>            Project directory
  --config <file>        Config file, relative to --cwd
  --env <name>           Config environment to apply ($env.<name> or $<name>). Defaults to $BETTER_SUPABASE_ENV, then ci when $CI is set
  --json                 Print one JSON document on stdout; errors as Problem Details. On by default in agent mode
  --agent <auto|yes|no>  Agent mode (JSON output, no prompts, consent for destructive work): auto detects a coding agent, yes or no decide. Defaults to $BETTER_SUPABASE_AGENT, then auto
  --confirm <token>      The token from a consent_required result, passed once the user agreed
  -y, --yes              Ask nothing; use the flags and the defaults
  --no-color             Print no colors, like $NO_COLOR
  --debug                Print stack traces, the commands the CLI runs, and timings on stderr
  -h, --help             Show help

Examples
  # Installs two blocks and the blocks they require
  $ better-supabase add organizations billing
  # Applies a preset to the config, shows the diff and writes the blocks' SQL
  $ better-supabase add --preset saas
  # Maps the teams block onto a table the app already has
  $ better-supabase add teams --adopt --tables public.teams
  # Adds the Hono glue
  $ better-supabase add --integration hono

Side effects: Writes files, reads the database with --adopt, calls the Supabase Management API with --project-ref.
Docs: https://bettersupabase.com/docs/cli/init#add
"
`;

exports[`help > documents blocks 1`] = `
"Usage: better-supabase blocks <command> [options]

Lists, shows and searches the blocks you can add, and decodes presets

Commands
  list    Lists the blocks, the ones this project installed with --installed, or a preset's with --preset
  view    Shows a block: the blocks it requires, its modes and its client, or its SQL with --sql
  search  Finds blocks by name, description or category

Global options
  --cwd <dir>            Project directory
  --config <file>        Config file, relative to --cwd
  --env <name>           Config environment to apply ($env.<name> or $<name>). Defaults to $BETTER_SUPABASE_ENV, then ci when $CI is set
  --json                 Print one JSON document on stdout; errors as Problem Details. On by default in agent mode
  --agent <auto|yes|no>  Agent mode (JSON output, no prompts, consent for destructive work): auto detects a coding agent, yes or no decide. Defaults to $BETTER_SUPABASE_AGENT, then auto
  --confirm <token>      The token from a consent_required result, passed once the user agreed
  -y, --yes              Ask nothing; use the flags and the defaults
  --no-color             Print no colors, like $NO_COLOR
  --debug                Print stack traces, the commands the CLI runs, and timings on stderr
  -h, --help             Show help

Docs: https://bettersupabase.com/docs/cli/presets#blocks
"
`;

exports[`help > documents blocks list 1`] = `
"Usage: better-supabase blocks list [options]

Lists the blocks, the ones this project installed with --installed, or a preset's with --preset

Options
  --category <name>         One category: identity, tenancy, collaboration, messaging, growth, crm, work, people, commerce, scheduling, content, ai, automation, developer, admin, database
  --installed               Every block's SQL with whether this project installed it and lists it in blocks
  --preset <name|code|url>  The blocks and conventions of a preset name, a design code or a /create URL
  --tests-dir <dir>         Where the pgtap module goes. Defaults to database.sql.testsDir

Global options
  --cwd <dir>            Project directory
  --config <file>        Config file, relative to --cwd
  --env <name>           Config environment to apply ($env.<name> or $<name>). Defaults to $BETTER_SUPABASE_ENV, then ci when $CI is set
  --json                 Print one JSON document on stdout; errors as Problem Details. On by default in agent mode
  --agent <auto|yes|no>  Agent mode (JSON output, no prompts, consent for destructive work): auto detects a coding agent, yes or no decide. Defaults to $BETTER_SUPABASE_AGENT, then auto
  --confirm <token>      The token from a consent_required result, passed once the user agreed
