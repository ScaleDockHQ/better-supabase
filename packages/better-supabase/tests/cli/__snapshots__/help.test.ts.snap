exports[`help > documents db seed 1`] = `
"Usage: better-supabase db seed [options]

Renders the fixtures from defineSeed() (better-supabase/testing) to SQL, and runs them with --apply

Options
  --apply          Also insert the rows into the database ($DATABASE_URL, $SUPABASE_DB_URL, --db-url-stdin, or the local stack)
  --entry <file>   Defaults to database.seed.entry (supabase/seed.ts)
  --out <file>     Defaults to database.seed.output (supabase/seeds/000_better_supabase.sql)
  --tenant <slug>  Insert database.seed.perTenant (supabase/seed.tenant.ts) for this organization slug or id, or '*' for every organization
  --db-url-stdin   Read the connection string from stdin instead of the config, $DATABASE_URL or $SUPABASE_DB_URL
  --stack <name>   Use the stack in supabase/stacks/<name>/config.toml (default $BSB_STACK) instead of the default local stack
  --dry-run        Print what would change, with a diff, and write nothing
  --check          Write nothing; exit 1 with a diff when a file would change
  --force          Overwrite files the CLI did not generate

Global options
  --cwd <dir>            Project directory
  --config <file>        Config file, relative to --cwd
  --env <name>           Config environment to apply ($env.<name> or $<name>). Defaults to $BETTER_SUPABASE_ENV, then ci when $CI is set
  --json                 Print one JSON document on stdout; errors as Problem Details. On by default in agent mode
  --agent <auto|yes|no>  Agent mode (JSON output, no prompts, consent for destructive work): auto detects a coding agent, yes or no decide. Defaults to $BETTER_SUPABASE_AGENT, then auto
  --confirm <token>      The token from a consent_required result, passed once the user agreed
  -y, --yes              Ask nothing; use the flags and the defaults
  --no-color             Print no colors, like $NO_COLOR
  --debug                Print stack traces, the commands the CLI runs, and timings on stderr
  -h, --help             Show help

Side effects: Writes files, writes to the database with --apply, writes to the database with --tenant.
Docs: https://bettersupabase.com/docs/cli/db#seed
"
`;

exports[`help > documents dev 1`] = `
"Usage: better-supabase dev <command> [options]

Works with the local stack: its env file, commands run against it, its signing key and the stacks on this machine

Commands
  env    Writes the local stack's URL and keys from \`supabase status\` to an env file, keeping its other lines
  run    Runs the command after -- with the local stack's URL and keys set, overriding the shell and .env files
  keys   Creates an ES256 signing key for the local stack, so local tokens verify through JWKS like hosted ones
  stack  Lists the Supabase CLI's managed stacks and prunes the ones whose worktree or branch is gone

Global options
  --cwd <dir>            Project directory
  --config <file>        Config file, relative to --cwd
  --env <name>           Config environment to apply ($env.<name> or $<name>). Defaults to $BETTER_SUPABASE_ENV, then ci when $CI is set
  --json                 Print one JSON document on stdout; errors as Problem Details. On by default in agent mode
  --agent <auto|yes|no>  Agent mode (JSON output, no prompts, consent for destructive work): auto detects a coding agent, yes or no decide. Defaults to $BETTER_SUPABASE_AGENT, then auto
  --confirm <token>      The token from a consent_required result, passed once the user agreed
  -y, --yes              Ask nothing; use the flags and the defaults
  --no-color             Print no colors, like $NO_COLOR
  --debug                Print stack traces, the commands the CLI runs, and timings on stderr
  -h, --help             Show help

Docs: https://bettersupabase.com/docs/cli/dev
"
`;

exports[`help > documents dev env 1`] = `
"Usage: better-supabase dev env [options]

Writes the local stack's URL and keys from \`supabase status\` to an env file, keeping its other lines

Options
  --write <file>, --out  Env file to write, or - to print the variables. Defaults to env.output, then .env.local
  --prefix <prefix>      Browser variable prefix: next, vite, expo, nuxt, astro, sveltekit, a literal prefix, or "none". Defaults to env.prefix, then one detected from your framework
  --status-file <file>   Read \`supabase status -o json\` output from a file
  --dry-run              Print what would change, with a diff, and write nothing
  --check                Write nothing; exit 1 with a diff when a file would change

Global options
  --cwd <dir>            Project directory
  --config <file>        Config file, relative to --cwd
  --env <name>           Config environment to apply ($env.<name> or $<name>). Defaults to $BETTER_SUPABASE_ENV, then ci when $CI is set
  --json                 Print one JSON document on stdout; errors as Problem Details. On by default in agent mode
  --agent <auto|yes|no>  Agent mode (JSON output, no prompts, consent for destructive work): auto detects a coding agent, yes or no decide. Defaults to $BETTER_SUPABASE_AGENT, then auto
  --confirm <token>      The token from a consent_required result, passed once the user agreed
  -y, --yes              Ask nothing; use the flags and the defaults
  --no-color             Print no colors, like $NO_COLOR
  --debug                Print stack traces, the commands the CLI runs, and timings on stderr
  -h, --help             Show help

Examples
  # Write the URL, keys and JWKS URL, plain and with NEXT_PUBLIC_
  $ better-supabase dev env --write .env.supabase.local --prefix next

Side effects: Writes files.
Docs: https://bettersupabase.com/docs/cli/dev#env
"
`;

