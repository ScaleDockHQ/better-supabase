  --out <file>          Env file to write, or - to print the variables. Defaults to env.output, then .env.local
  --prefix <prefix>     Prefix for browser variables. Defaults to env.prefix, then one detected from your framework; "none" for no prefix
  --status-file <file>  Read \`supabase status -o json\` output from a file
  --dry-run             Print what would change, with a diff, and write nothing
