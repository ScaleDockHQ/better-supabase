exports[`help > documents scaffold 1`] = `
"Writes an API module, its resource routes and an OpenAPI route for Hono or Next.js (better-supabase scaffold v<version>)

USAGE better-supabase scaffold [OPTIONS] [KIND]

ARGUMENTS

  KIND    api

OPTIONS

  --framework=<name>    hono or next. Defaults to the one in package.json                                                              
     --tables=<list>    Tables to serve. Defaults to every table and view in the public schema                                         
       --name=<name>    The API module's name: lib/<name>.ts and lib/<name>.generated.ts. Defaults to api                              
  --base-path=<path>    Where the resources are served. Defaults to /api                                                               
         --cwd=<dir>    Project directory                                                                                              
     --config=<file>    Config file, relative to --cwd                                                                                 
        --env=<name>    Config environment to apply ($env.<name> or $<name>). Defaults to $BETTER_SUPABASE_ENV, then ci when $CI is set
              --json    Print one JSON document on stdout; errors as Problem Details                                                   
           -y, --yes    Ask nothing; use the flags and the defaults                                                                    
"
`;

exports[`help > documents seed 1`] = `
"Renders the fixtures from defineSeed() (better-supabase/testing) to SQL (better-supabase seed v<version>)

USAGE better-supabase seed [OPTIONS] 

OPTIONS

          --check    Fail when the SQL file is out of date                                                                          
          --apply    Also insert the rows into the database ($DATABASE_URL, $SUPABASE_DB_URL, --db-url-stdin, or the local stack)   
   --entry=<file>    Defaults to seed.entry (supabase/seed.ts)                                                                      
     --out=<file>    Defaults to seed.output (supabase/seeds/000_better_supabase.sql)                                               
   --db-url-stdin    Read the connection string from stdin instead of the config, $DATABASE_URL or $SUPABASE_DB_URL                 
      --cwd=<dir>    Project directory                                                                                              
  --config=<file>    Config file, relative to --cwd                                                                                 
     --env=<name>    Config environment to apply ($env.<name> or $<name>). Defaults to $BETTER_SUPABASE_ENV, then ci when $CI is set
           --json    Print one JSON document on stdout; errors as Problem Details                                                   
        -y, --yes    Ask nothing; use the flags and the defaults                                                                    
"
`;

exports[`help > documents skills 1`] = `
"Installs the Agent Skills that ship with this version of better-supabase (better-supabase skills v<version>)

USAGE better-supabase skills [OPTIONS] [ACTION]

ARGUMENTS

  ACTION    list or install

OPTIONS

  --agent=<names>    cursor (.cursor/skills), claude (.claude/skills) or agents (.agents/skills). Defaults to skills.agents, then the agent folders the project has, else agents
         --global    Install into your home directory instead of the project                                                                                                    
          --check    Fail when installed skills differ from this version                                                                                                        
     --from=<dir>    Read skills from this folder instead of the package                                                                                                        
      --cwd=<dir>    Project directory                                                                                                                                          
  --config=<file>    Config file, relative to --cwd                                                                                                                             
     --env=<name>    Config environment to apply ($env.<name> or $<name>). Defaults to $BETTER_SUPABASE_ENV, then ci when $CI is set                                            
           --json    Print one JSON document on stdout; errors as Problem Details                                                                                               
        -y, --yes    Ask nothing; use the flags and the defaults                                                                                                                
"
`;

exports[`help > documents spec 1`] = `
"Writes, checks or validates the OpenAPI and other spec documents your defineApi() module renders (better-supabase spec v<version>)

USAGE better-supabase spec [OPTIONS] [ACTION] [FORMAT]

ARGUMENTS

  ACTION    emit, check or validate                                            
  FORMAT    Only this format (openapi, asyncapi, arazzo, or one the entry adds)

OPTIONS

  --spec-version=<version>    Render this version of the format instead of the configured one                                                
              --out=<file>    Write the one selected output to this file                                                                     
            --entry=<file>    Defaults to specs.entry. Exports \`api\` (defineApi) or a document                                               
                    --yaml    Write YAML instead of JSON                                                                                     
               --ui=<name>    Also write a reference page next to OpenAPI outputs: scalar, swagger, redoc, elements or rapidoc               
         --fail-on=<level>    Exit 1 on findings at this level: error (default), warning or never                                            
         --manifest=<file>    Also write the diagnostics manifest (JSON) to this file. Defaults to specs.manifest                            
                   --cache    Reuse renders whose inputs did not change (Default: true)                                                      
                --no-cache    Render every output again                                                                                      
                   --watch    With emit, render again whenever the entry, the config or an overlay changes                                   
           --interval=<ms>    Milliseconds between checks in --watch. Defaults to gen.watchInterval, then 2000                               
               --cwd=<dir>    Project directory                                                                                              
           --config=<file>    Config file, relative to --cwd                                                                                 
              --env=<name>    Config environment to apply ($env.<name> or $<name>). Defaults to $BETTER_SUPABASE_ENV, then ci when $CI is set
                    --json    Print one JSON document on stdout; errors as Problem Details                                                   
                 -y, --yes    Ask nothing; use the flags and the defaults                                                                    
"
`;

exports[`help > documents sql 1`] = `
"Lists, adds, syncs, upgrades and prints SQL modules, and writes their data migration (better-supabase sql v<version>)

USAGE better-supabase sql [OPTIONS] [ACTION]

ARGUMENTS

  ACTION    list (modules and whether they are installed), add <module...>, sync, upgrade, data (a migration with the rows a schema diff skips) or print <module>

OPTIONS

            --check    With sync: fail when a file is stale. With upgrade: fail when a module is behind                               
  --tests-dir=<dir>    Where the pgtap module goes. Defaults to sql.testsDir                                                          
          --dry-run    Show what would be written                                                                                     
            --force    Write tenant even though the authorization provider's hook owns the memberships claim                          
        --cwd=<dir>    Project directory                                                                                              
    --config=<file>    Config file, relative to --cwd                                                                                 
       --env=<name>    Config environment to apply ($env.<name> or $<name>). Defaults to $BETTER_SUPABASE_ENV, then ci when $CI is set
             --json    Print one JSON document on stdout; errors as Problem Details                                                   
          -y, --yes    Ask nothing; use the flags and the defaults                                                                    
"
`;

exports[`help > lists the commands and the global options 1`] = `
"Typed Supabase: codegen, doctor, the SQL modules and project setup (better-supabase v<version>)

USAGE better-supabase [OPTIONS] init|add|apply|preset|blocks|env|keys|skills|gen|introspect|openapi|spec|scaffold|seed|doctor|sql|config|codemod

OPTIONS

      --cwd=<dir>    Project directory                                                                                              
  --config=<file>    Config file, relative to --cwd                                                                                 
     --env=<name>    Config environment to apply ($env.<name> or $<name>). Defaults to $BETTER_SUPABASE_ENV, then ci when $CI is set
           --json    Print one JSON document on stdout; errors as Problem Details                                                   
        -y, --yes    Ask nothing; use the flags and the defaults                                                                    

COMMANDS

        init    Writes better-supabase.config.ts, src/lib/supabase/index.ts and glue for the frameworks in package.json    
         add    Adds blocks with what they require, or glue for an integration with --framework                            
       apply    Applies a preset to an existing project: edits the config, shows the diff and writes the blocks' modules   
      preset    Decodes a preset code, or shows the config's preset and how the config differs from it                     
      blocks    Lists, shows and searches the blocks you can add                                                           
         env    Writes the local stack's URL and keys from \`supabase status\` to an env file, keeping its other lines       
        keys    Creates an ES256 signing key for the local stack, so local tokens verify through JWKS like hosted ones     
      skills    Installs the Agent Skills that ship with this version of better-supabase                                   
         gen    Writes the typed client from the database, then every other generated file the config sets up              
  introspect    Saves the database schema as a snapshot for offline gen                                                    
     openapi    Writes the document your createOpenApi() module exports, so CI can check it for drift                      
        spec    Writes, checks or validates the OpenAPI and other spec documents your defineApi() module renders           
    scaffold    Writes an API module, its resource routes and an OpenAPI route for Hono or Next.js                         
        seed    Renders the fixtures from defineSeed() (better-supabase/testing) to SQL                                    
      doctor    Checks RLS, indexes, drift, auth config and env files; exits 1 on errors, or on warnings with --strict     
         sql    Lists, adds, syncs, upgrades and prints SQL modules                                                        
      config    Prints the resolved config: the file it came from, the active environment and every option with its default
     codemod    Rewrites imports and calls for renamed better-supabase APIs                                                

Use better-supabase <command> --help for more information about a command."
`;
