exports[`help > documents spec 1`] = `
"Usage: better-supabase spec <command> [options]

Writes, checks or validates the OpenAPI and other spec documents your defineApi() module renders

Commands
  emit      Writes the spec documents, or exits 1 when one is out of date with --check
  validate  Validates the documents against their specs and lints them, writing nothing

Global options
  --cwd <dir>            Project directory
  --config <file>        Config file, relative to --cwd
  --env <name>           Config environment to apply ($env.<name> or $<name>). Defaults to $BETTER_SUPABASE_ENV, then ci when $CI is set
  --json                 Print one JSON document on stdout; errors as Problem Details. On by default in agent mode
  --agent <auto|yes|no>  Agent mode (JSON output, no prompts, consent for destructive work): auto detects a coding agent, yes or no decide. Defaults to $BETTER_SUPABASE_AGENT, then auto
  --confirm <token>      The token from a consent_required result, passed once the user agreed
  -y, --yes              Ask nothing; use the flags and the defaults
  --no-color             Print no colors, like $NO_COLOR
  --debug                Print stack traces, the commands the CLI runs, and timings on stderr
  -h, --help             Show help

Docs: https://bettersupabase.com/docs/cli/spec
"
`;

exports[`help > documents spec emit 1`] = `
"Usage: better-supabase spec emit [options] [format]

Writes the spec documents, or exits 1 when one is out of date with --check

Arguments
  [format]  Only this format (openapi, asyncapi, arazzo, or one the entry adds)

Options
  --spec-version <version>  Render this version of the format instead of the configured one
  --out <file>              Write the one selected output to this file
  --entry <file>            Defaults to specs.entry. Exports \`api\` (defineApi) or a document
  --yaml                    Write YAML instead of JSON
  --ui <name>               Also write a reference page next to OpenAPI outputs: scalar, swagger, redoc, elements or rapidoc
  --fail-on <level>         Exit 1 on findings at this level: error (default), warning or never
  --manifest <file>         Also write the diagnostics manifest (JSON) to this file. Defaults to specs.manifest
  --no-cache                Render every output again
  --watch                   With emit, render again whenever the entry, the config, an overlay or a topic module changes
  --interval <ms>           Milliseconds between checks in --watch. Defaults to gen.watchInterval, then 2000
  --dry-run                 Print what would change and write nothing
  --check                   Write nothing; exit 1 with a diff when an output is out of date

Global options
  --cwd <dir>            Project directory
  --config <file>        Config file, relative to --cwd
  --env <name>           Config environment to apply ($env.<name> or $<name>). Defaults to $BETTER_SUPABASE_ENV, then ci when $CI is set
  --json                 Print one JSON document on stdout; errors as Problem Details. On by default in agent mode
  --agent <auto|yes|no>  Agent mode (JSON output, no prompts, consent for destructive work): auto detects a coding agent, yes or no decide. Defaults to $BETTER_SUPABASE_AGENT, then auto
  --confirm <token>      The token from a consent_required result, passed once the user agreed
  -y, --yes              Ask nothing; use the flags and the defaults
  --no-color             Print no colors, like $NO_COLOR
  --debug                Print stack traces, the commands the CLI runs, and timings on stderr
  -h, --help             Show help

Examples
  # Writes the OpenAPI document
  $ better-supabase spec emit openapi
  # Exits 1 when a written document is out of date
  $ better-supabase spec emit --check

Side effects: Writes files.
Docs: https://bettersupabase.com/docs/cli/spec
"
`;

