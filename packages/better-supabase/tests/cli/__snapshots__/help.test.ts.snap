// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`help > documents add 1`] = `
"Adds blocks with what they require, or glue for an integration with --framework (better-supabase add v<version>)

USAGE better-supabase add [OPTIONS] [BLOCK]

ARGUMENTS

  BLOCK    Blocks to add (\`better-supabase blocks list\`). Without blocks or --framework, sets up the integrations in the config that have no files yet

OPTIONS

  --framework=<integration,...>    Adds glue for integrations instead: next, hono, orpc, edge, expo, mcp, client or react                         
                        --force    Overwrite files that exist; with blocks, write modules a provider's hook would duplicate                       
                      --dry-run    Show what would be written                                                                                     
                    --cwd=<dir>    Project directory                                                                                              
                --config=<file>    Config file, relative to --cwd                                                                                 
                   --env=<name>    Config environment to apply ($env.<name> or $<name>). Defaults to $BETTER_SUPABASE_ENV, then ci when $CI is set
                         --json    Print one JSON document on stdout; errors as Problem Details                                                   
                      -y, --yes    Ask nothing; use the flags and the defaults                                                                    
"
`;

exports[`help > documents apply 1`] = `
"Applies a preset to an existing project: edits the config, shows the diff and writes the blocks' modules (better-supabase apply v<version>)

USAGE better-supabase apply [OPTIONS] 

OPTIONS

     --preset=<name|code|url>    A named preset, a code from /create or its URL                                                                      
  --only=<blocks|conventions>    blocks: add the preset's blocks to blocks and leave the conventions; conventions: take the conventions and no blocks
                    --dry-run    Show the config diff and write nothing                                                                              
                  --cwd=<dir>    Project directory                                                                                                   
              --config=<file>    Config file, relative to --cwd                                                                                      
                 --env=<name>    Config environment to apply ($env.<name> or $<name>). Defaults to $BETTER_SUPABASE_ENV, then ci when $CI is set     
                       --json    Print one JSON document on stdout; errors as Problem Details                                                        
                    -y, --yes    Ask nothing; use the flags and the defaults                                                                         
"
`;

exports[`help > documents blocks 1`] = `
"Lists, shows and searches the blocks you can add (better-supabase blocks v<version>)

USAGE better-supabase blocks [OPTIONS] [ACTION]

ARGUMENTS

  ACTION    list, view or search

OPTIONS

  --category=<name>    With list: one category (foundation, collaboration, crm, work, commerce, scheduling, ai, content, operations or platform)
        --cwd=<dir>    Project directory                                                                                                        
    --config=<file>    Config file, relative to --cwd                                                                                           
       --env=<name>    Config environment to apply ($env.<name> or $<name>). Defaults to $BETTER_SUPABASE_ENV, then ci when $CI is set          
             --json    Print one JSON document on stdout; errors as Problem Details                                                             
          -y, --yes    Ask nothing; use the flags and the defaults                                                                              
"
`;

exports[`help > documents codemod 1`] = `
"Rewrites imports and calls for renamed better-supabase APIs (better-supabase codemod v<version>)

USAGE better-supabase codemod [OPTIONS] [NAME]

ARGUMENTS

  NAME    The codemod (0.4, 0.5 or 0.6), then the files or directories to rewrite (default: the project)

OPTIONS

        --dry-run    Show the changes without writing them                                                                          
      --cwd=<dir>    Project directory                                                                                              
  --config=<file>    Config file, relative to --cwd                                                                                 
     --env=<name>    Config environment to apply ($env.<name> or $<name>). Defaults to $BETTER_SUPABASE_ENV, then ci when $CI is set
           --json    Print one JSON document on stdout; errors as Problem Details                                                   
        -y, --yes    Ask nothing; use the flags and the defaults                                                                    
"
`;

exports[`help > documents config 1`] = `
"Prints the resolved config: the file it came from, the active environment and every option with its default (better-supabase config v<version>)

USAGE better-supabase config [OPTIONS] 

OPTIONS

      --cwd=<dir>    Project directory                                                                                              
  --config=<file>    Config file, relative to --cwd                                                                                 
     --env=<name>    Config environment to apply ($env.<name> or $<name>). Defaults to $BETTER_SUPABASE_ENV, then ci when $CI is set
           --json    Print one JSON document on stdout; errors as Problem Details                                                   
        -y, --yes    Ask nothing; use the flags and the defaults                                                                    
"
`;

exports[`help > documents doctor 1`] = `
"Checks RLS, indexes, drift, auth config and env files; exits 1 on errors, or on warnings with --strict (better-supabase doctor v<version>)

USAGE better-supabase doctor [OPTIONS] 

OPTIONS

    --format=<format>    text, sarif (code scanning) or github (workflow annotations); also doctor.format, default text. --json for the JSON report
         --out=<file>    Write the report to a file; also doctor.output                                                                            
       --only=<codes>    Run only these checks, e.g. --only BS100,BS304; also doctor.only                                                          
     --ignore=<codes>    Skip checks; also doctor.ignore in the config                                                                             
             --strict    Fail on warnings; also doctor.strict                                                                                      
    --snapshot=<file>    Check a saved snapshot instead of the database                                                                            
  --metadata=<path|->    Check a GeneratorMetadata document (- for stdin); checks it lacks data for are skipped                                    
       --db-url-stdin    Read the connection string from stdin instead of the config, $DATABASE_URL or $SUPABASE_DB_URL                            
  --project-ref=<ref>    Read a hosted project through the Management API                                                                          
              --stats    Report slow frequent statements from pg_stat_statements (BS209)                                                           
   --explain=<tables>    EXPLAIN ANALYZE these tables under RLS, rolled back (BS212)                                                               
          --as=<uuid>    Plan as this authenticated user, and measure the claims the custom access token hook returns for them (BS405)             
      --claims=<json>    Plan with these JWT claims ({"role":"authenticated",...})                                                                 
         --fix-grants    Print the grant and revoke SQL BS404 asks for, to add to your schema or migration                                         
          --cwd=<dir>    Project directory                                                                                                         
      --config=<file>    Config file, relative to --cwd                                                                                            
         --env=<name>    Config environment to apply ($env.<name> or $<name>). Defaults to $BETTER_SUPABASE_ENV, then ci when $CI is set           
               --json    Print one JSON document on stdout; errors as Problem Details                                                              
            -y, --yes    Ask nothing; use the flags and the defaults                                                                               
"
`;

exports[`help > documents env 1`] = `
"Writes the local stack's URL and keys from \`supabase status\` to an env file, keeping its other lines (better-supabase env v<version>)

USAGE better-supabase env [OPTIONS] 

OPTIONS

       --out=<file>    Env file to write. Defaults to env.output, then .env.local                                                       
  --prefix=<prefix>    Prefix for browser variables. Defaults to env.prefix, then one detected from your framework; "none" for no prefix
      --from=<file>    Read \`supabase status -o json\` output from a file                                                                
            --print    Print the variables instead of writing them                                                                      
        --cwd=<dir>    Project directory                                                                                                
    --config=<file>    Config file, relative to --cwd                                                                                   
       --env=<name>    Config environment to apply ($env.<name> or $<name>). Defaults to $BETTER_SUPABASE_ENV, then ci when $CI is set  
             --json    Print one JSON document on stdout; errors as Problem Details                                                     
          -y, --yes    Ask nothing; use the flags and the defaults                                                                      
"
`;

exports[`help > documents gen 1`] = `
"Writes the typed client from the database, then every other generated file the config sets up (better-supabase gen v<version>)

USAGE better-supabase gen [OPTIONS] 

OPTIONS

  --metadata=<path|->    Read a GeneratorMetadata document (- for stdin) and print one file on stdout                                     
        --emit=<file>    With --metadata, the file to print: schema, types, zod, valibot, json-schema, standard-schema. Defaults to schema
          --out=<dir>    With --metadata, write every generated file into this directory instead of printing one                          
       --tasks=<list>    Tasks to run: types, sql, spec, seed, scaffold, env. Defaults to gen.tasks, or every task the config sets up     
              --check    Fail when a generated file is out of date                                                                        
              --watch    Run again whenever the schema, the config file or a task's input changes                                         
      --interval=<ms>    Milliseconds between checks in --watch. Defaults to gen.watchInterval, then 2000                                 
    --snapshot=<file>    Read a saved snapshot instead of the database                                                                    
       --db-url-stdin    Read the connection string from stdin instead of the config, $DATABASE_URL or $SUPABASE_DB_URL                   
  --project-ref=<ref>    Read a hosted project through the Management API                                                                 
          --cwd=<dir>    Project directory                                                                                                
      --config=<file>    Config file, relative to --cwd                                                                                   
         --env=<name>    Config environment to apply ($env.<name> or $<name>). Defaults to $BETTER_SUPABASE_ENV, then ci when $CI is set  
               --json    Print one JSON document on stdout; errors as Problem Details                                                     
            -y, --yes    Ask nothing; use the flags and the defaults                                                                      
"
`;

exports[`help > documents init 1`] = `
"Writes better-supabase.config.ts, src/lib/supabase/index.ts and glue for the frameworks in package.json (better-supabase init v<version>)

USAGE better-supabase init [OPTIONS] 

OPTIONS

                  --casing=<camel|snake>    Row keys in camelCase (camel, the default) or the database's snake_case (snake)                                         
                --with=<integration,...>    Integrations to add next to the detected ones: next, hono, orpc, edge, expo, mcp, client, react                         
                         --package=<dir>    Workspace package to write to, relative to --cwd                                                                        
  --workflow=<pg-delta|migra|migrations>    How the SQL modules reach the database: pg-delta (the default), migra or migrations                                     
                --preset=<name|code|url>    A named preset, a code from /create or its URL: the config starts from it, and init writes its modules and lib/blocks.ts
                                  --lite    Run on Supabase Lite: install @supabase/lite and use its CLI in the next steps                                          
                                 --force    Overwrite files that exist                                                                                              
                               --dry-run    Show what would be written                                                                                              
                             --cwd=<dir>    Project directory                                                                                                       
                         --config=<file>    Config file, relative to --cwd                                                                                          
                            --env=<name>    Config environment to apply ($env.<name> or $<name>). Defaults to $BETTER_SUPABASE_ENV, then ci when $CI is set         
                                  --json    Print one JSON document on stdout; errors as Problem Details                                                            
                               -y, --yes    Ask nothing; use the flags and the defaults                                                                             
"
`;

exports[`help > documents introspect 1`] = `
"Saves the database schema as a snapshot for offline gen (better-supabase introspect v<version>)

USAGE better-supabase introspect [OPTIONS] 

OPTIONS

                            --out=<file>    Defaults to source.snapshot, supabase/snapshot.json, or supabase/generator-metadata.json                       
  --format=<snapshot|generator-metadata>    snapshot (the default) or generator-metadata (postgrest-typegen's input)                                       
                                 --check    Fail when the file is out of date                                                                              
                       --snapshot=<file>    Read a saved snapshot instead of the database                                                                  
                          --db-url-stdin    Read the connection string from stdin instead of the config, $DATABASE_URL or $SUPABASE_DB_URL                 
                     --project-ref=<ref>    Read a hosted project through the Management API                                                               
                             --cwd=<dir>    Project directory                                                                                              
                         --config=<file>    Config file, relative to --cwd                                                                                 
                            --env=<name>    Config environment to apply ($env.<name> or $<name>). Defaults to $BETTER_SUPABASE_ENV, then ci when $CI is set
                                  --json    Print one JSON document on stdout; errors as Problem Details                                                   
                               -y, --yes    Ask nothing; use the flags and the defaults                                                                    
"
`;

exports[`help > documents keys 1`] = `
"Creates an ES256 signing key for the local stack, so local tokens verify through JWKS like hosted ones (better-supabase keys v<version>)

USAGE better-supabase keys [OPTIONS] 

OPTIONS

     --out=<file>    Defaults to keys.output, then supabase/signing_keys.json                                                       
         --rotate    Put a new key first (it signs) and keep the old ones (they still verify)                                       
          --force    Replace the file                                                                                               
      --cwd=<dir>    Project directory                                                                                              
  --config=<file>    Config file, relative to --cwd                                                                                 
     --env=<name>    Config environment to apply ($env.<name> or $<name>). Defaults to $BETTER_SUPABASE_ENV, then ci when $CI is set
           --json    Print one JSON document on stdout; errors as Problem Details                                                   
        -y, --yes    Ask nothing; use the flags and the defaults                                                                    
"
`;

exports[`help > documents openapi 1`] = `
"Writes the document your createOpenApi() module exports, so CI can check it for drift (better-supabase openapi v<version>)

USAGE better-supabase openapi [OPTIONS] [ACTION]

ARGUMENTS

  ACTION    emit

OPTIONS

          --check    Fail when the file differs from the document                                                                   
   --entry=<file>    Defaults to openapi.entry. Exports \`openapi\` or default: a document or a function returning one                
     --out=<file>    Defaults to openapi.output                                                                                     
      --cwd=<dir>    Project directory                                                                                              
  --config=<file>    Config file, relative to --cwd                                                                                 
     --env=<name>    Config environment to apply ($env.<name> or $<name>). Defaults to $BETTER_SUPABASE_ENV, then ci when $CI is set
           --json    Print one JSON document on stdout; errors as Problem Details                                                   
        -y, --yes    Ask nothing; use the flags and the defaults                                                                    
"
`;

