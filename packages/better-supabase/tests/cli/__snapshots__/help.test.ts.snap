// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`help > documents add 1`] = `
"Usage: better-supabase add [options] [block...]

Adds blocks with what they require, or glue for an integration with --integration

Arguments
  [block...]  Blocks to install with what they require (\`better-supabase blocks list\`). Without blocks or --integration, sets up the integrations in the config that have no files yet

Options
  --integration <integration,...>  Adds glue for integrations instead: next, hono, orpc, edge, expo, mcp, client or react
  --force                          Overwrite files that exist
  --allow-hook-overlap             With blocks: write modules whose claim the authorization provider's hook already writes
  --tests-dir <dir>                With blocks: where the pgtap module goes. Defaults to sql.testsDir
  --dry-run                        Print what would change, with a diff, and write nothing
  --check                          Write nothing; exit 1 with a diff when a file would change

Global options
  --cwd <dir>            Project directory
  --config <file>        Config file, relative to --cwd
  --env <name>           Config environment to apply ($env.<name> or $<name>). Defaults to $BETTER_SUPABASE_ENV, then ci when $CI is set
  --json                 Print one JSON document on stdout; errors as Problem Details. On by default in agent mode
  --agent <auto|yes|no>  Agent mode (JSON output, no prompts, consent for destructive work): auto detects a coding agent, yes or no decide. Defaults to $BETTER_SUPABASE_AGENT, then auto
  --confirm <token>      The token from a consent_required result, passed once the user agreed
  -y, --yes              Ask nothing; use the flags and the defaults
  --no-color             Print no colors, like $NO_COLOR
  --debug                Print stack traces, the commands the CLI runs, and timings on stderr
  -h, --help             Show help

Examples
  # Installs two blocks and the modules they require
  $ better-supabase add organizations billing
  # Adds the Hono glue
  $ better-supabase add --integration hono

Side effects: Writes files.
Docs: https://bettersupabase.com/docs/cli/init#add
"
`;

exports[`help > documents adopt 1`] = `
"Usage: better-supabase adopt [options] [block]

Maps a block onto tables the app already has: proposes blocks.<block> in adopt mode and reports what can't map

Arguments
  [block]  The block to adopt existing tables for

Options
  --tables <schema.table,...>  The existing tables, as table or schema.table; the block's other tables are looked up by their default names
  --dry-run                    Show the proposed mapping and the config diff, and write nothing
  --check                      Write nothing; exit 1 with the diff when the config lacks this mapping
  --snapshot <file>            Read a saved snapshot instead of the database
  --db-url-stdin               Read the connection string from stdin instead of the config, $DATABASE_URL or $SUPABASE_DB_URL
  --project-ref <ref>          Read a hosted project through the Management API

Global options
  --cwd <dir>            Project directory
  --config <file>        Config file, relative to --cwd
  --env <name>           Config environment to apply ($env.<name> or $<name>). Defaults to $BETTER_SUPABASE_ENV, then ci when $CI is set
  --json                 Print one JSON document on stdout; errors as Problem Details. On by default in agent mode
  --agent <auto|yes|no>  Agent mode (JSON output, no prompts, consent for destructive work): auto detects a coding agent, yes or no decide. Defaults to $BETTER_SUPABASE_AGENT, then auto
  --confirm <token>      The token from a consent_required result, passed once the user agreed
  -y, --yes              Ask nothing; use the flags and the defaults
  --no-color             Print no colors, like $NO_COLOR
  --debug                Print stack traces, the commands the CLI runs, and timings on stderr
  -h, --help             Show help

Side effects: Writes files, reads the database, calls the Supabase Management API with --project-ref.
Docs: https://bettersupabase.com/docs/cli/presets#adopt
"
`;

exports[`help > documents apply 1`] = `
"Usage: better-supabase apply [options]

Applies a preset to an existing project: edits the config, shows the diff and writes the blocks' modules

Options
  --preset <name|code|url>                  A named preset, a code from /create or its URL; a URL's design (&design=) adds its app tables and extra columns
  --package <dir>                           Workspace package whose config to edit, relative to --cwd; a Create URL's package= sets it too
  --only <blocks|conventions>               blocks: add the preset's blocks to blocks and leave the conventions; conventions: take the conventions and no blocks
  --adopt                                   Map the preset's blocks onto tables the database already has under their default names (adopt mode)
  --allow-breaking                          Write a design that drops, renames or retypes app table columns, or makes one required without a default
  --dry-run                                 Show the config diff and write nothing
  --check                                   Write nothing; exit 1 with the diff when the config lacks the preset
  --casing <snake|camel>                    Row keys: snake keeps the database's names (the default), camel renames them in the query
  --scope <tenant|user|none>                Row ownership (sql.scope): tenant (the default), user or none for one shared space
  --tenant-name <name>                      What a tenant is called (sql.naming.tenant): organization (the default), workspace, team or another lowercase name
  --access <roles|catalog|provider|custom>  Auth and permissions (blocks.access.model): roles (the default), catalog, provider or custom
  --id-type <uuid|text|bigint|integer>      The type of the access block's ids (blocks.access.idType): uuid (the default), text, bigint or integer
  --api <none|api>                          API schema (sql.api): none (the default) or api for security invoker wrappers in an api schema
  --snapshot <file>                         Read a saved snapshot instead of the database
  --db-url-stdin                            Read the connection string from stdin instead of the config, $DATABASE_URL or $SUPABASE_DB_URL
  --project-ref <ref>                       Read a hosted project through the Management API

Global options
  --cwd <dir>            Project directory
  --config <file>        Config file, relative to --cwd
  --env <name>           Config environment to apply ($env.<name> or $<name>). Defaults to $BETTER_SUPABASE_ENV, then ci when $CI is set
  --json                 Print one JSON document on stdout; errors as Problem Details. On by default in agent mode
  --agent <auto|yes|no>  Agent mode (JSON output, no prompts, consent for destructive work): auto detects a coding agent, yes or no decide. Defaults to $BETTER_SUPABASE_AGENT, then auto
  --confirm <token>      The token from a consent_required result, passed once the user agreed
  -y, --yes              Ask nothing; use the flags and the defaults
  --no-color             Print no colors, like $NO_COLOR
  --debug                Print stack traces, the commands the CLI runs, and timings on stderr
  -h, --help             Show help

Side effects: Writes files, reads the database with --adopt, calls the Supabase Management API with --project-ref.
Docs: https://bettersupabase.com/docs/cli/presets#apply
"
`;

