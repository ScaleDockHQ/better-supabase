exports[`help > documents doctor 1`] = `
"Usage: better-supabase doctor [options]

Checks RLS, indexes, drift, auth config and env files; exits 1 on errors, or on warnings with --fail-on warning

Options
  --snapshot <file>       Read a saved snapshot instead of the database
  --db-url-stdin          Read the connection string from stdin instead of the config, $DATABASE_URL or $SUPABASE_DB_URL
  --project-ref <ref>     Read a hosted project through the Management API
  --format <format>       text, sarif (code scanning) or github (workflow annotations); also tooling.doctor.format, default text. --json for the JSON report
  --out <file>            Write the report to a file; also tooling.doctor.output
  --only <codes,...>      Run only these checks, e.g. --only BS100,BS304; also tooling.doctor.only
  --ignore <codes,...>    Skip checks; also tooling.doctor.ignore in the config
  --fail-on <level>       Exit 1 on findings at this level: error (the default), warning (the default with tooling.doctor.strict) or never
  --metadata <path|->     Check a GeneratorMetadata document (- for stdin); checks it lacks data for are skipped
  --stats                 Report slow frequent statements from pg_stat_statements (BS209)
  --explain <tables,...>  EXPLAIN ANALYZE these tables under RLS, rolled back (BS212)
  --as <uuid>             Plan as this authenticated user, and measure the claims the custom access token hook returns for them (BS405)
  --claims <json>         Plan with these JWT claims ({"role":"authenticated",...})
  --fix-grants            Print the grant and revoke SQL BS404 asks for, to add to your schema or migration
  --fix                   Run the SQL that resolves findings which carry a fix, such as validating a not valid check (BS236), against the database
  --update-baseline       Rewrite tooling.doctor.baseline to accept this run's errors and warnings, keeping each entry's reason

Global options
  --cwd <dir>            Project directory
  --config <file>        Config file, relative to --cwd
  --env <name>           Config environment to apply ($env.<name> or $<name>). Defaults to $BETTER_SUPABASE_ENV, then ci when $CI is set
  --json                 Print one JSON document on stdout; errors as Problem Details. On by default in agent mode
  --agent <auto|yes|no>  Agent mode (JSON output, no prompts, consent for destructive work): auto detects a coding agent, yes or no decide. Defaults to $BETTER_SUPABASE_AGENT, then auto
  --confirm <token>      The token from a consent_required result, passed once the user agreed
  -y, --yes              Ask nothing; use the flags and the defaults
  --no-color             Print no colors, like $NO_COLOR
  --debug                Print stack traces, the commands the CLI runs, and timings on stderr
  -h, --help             Show help

Examples
  # Checks the local database and the project
  $ better-supabase doctor
  # Writes the findings for code scanning
  $ better-supabase doctor --format sarif --out doctor.sarif

Side effects: Reads the database, writes to the database with --fix, calls the Supabase Management API with --project-ref, downloads from GitHub.
Docs: https://bettersupabase.com/docs/cli/doctor
"
`;

exports[`help > documents gen 1`] = `
"Usage: better-supabase gen [options]

Writes the typed client from the database, then every other generated file the config sets up

Options
  --metadata <path|->                   Read a GeneratorMetadata document (- for stdin) and print one file on stdout
  --emit <file>                         With --metadata, the file to print: schema, types, zod, valibot, json-schema, standard-schema. Defaults to schema
  --out-dir <dir>                       With --metadata, write every generated file into this directory instead of printing one
  --only <list,...>                     Tasks to run: types, sql, powersync, spec, seed, env. Defaults to gen.tasks, or every task the config sets up
  --check                               Fail when a generated file is out of date
  --dry-run                             Print what would change and write nothing
  --force                               Overwrite a file at a generated path that the CLI did not write
  --watch                               Run again whenever the schema, the config file or a task's input changes
  --interval <ms>                       Milliseconds between checks in --watch. Defaults to gen.watchInterval, then 2000
  --save-snapshot                       Read the database and save the schema as a snapshot file instead of generating
  --out <file>                          With --save-snapshot: defaults to database.source.snapshot, supabase/snapshot.json, or supabase/generator-metadata.json
  --kind <snapshot|generator-metadata>  With --save-snapshot: snapshot (the default) or generator-metadata (postgrest-typegen's input)
  --snapshot <file>                     Read a saved snapshot instead of the database
  --db-url-stdin                        Read the connection string from stdin instead of the config, $DATABASE_URL or $SUPABASE_DB_URL
  --project-ref <ref>                   Read a hosted project through the Management API

Global options
  --cwd <dir>            Project directory
  --config <file>        Config file, relative to --cwd
  --env <name>           Config environment to apply ($env.<name> or $<name>). Defaults to $BETTER_SUPABASE_ENV, then ci when $CI is set
  --json                 Print one JSON document on stdout; errors as Problem Details. On by default in agent mode
  --agent <auto|yes|no>  Agent mode (JSON output, no prompts, consent for destructive work): auto detects a coding agent, yes or no decide. Defaults to $BETTER_SUPABASE_AGENT, then auto
  --confirm <token>      The token from a consent_required result, passed once the user agreed
  -y, --yes              Ask nothing; use the flags and the defaults
  --no-color             Print no colors, like $NO_COLOR
  --debug                Print stack traces, the commands the CLI runs, and timings on stderr
  -h, --help             Show help

Examples
  # Regenerates every file the config sets up
  $ better-supabase gen
  # Exits 1 when a generated file is out of date
  $ better-supabase gen --check
  # Saves the database schema as a snapshot for offline gen
  $ better-supabase gen --save-snapshot

Side effects: Writes files, reads the database, calls the Supabase Management API with --project-ref.
Docs: https://bettersupabase.com/docs/cli/gen
"
`;

exports[`help > documents init 1`] = `
"Usage: better-supabase init [options]

Writes better-supabase.config.ts, src/lib/supabase/index.ts and glue for the frameworks in package.json

Options
  --casing <snake|camel>                    Row keys: snake keeps the database's names (the default), camel renames them in the query
  --scope <tenant|user|none>                Row ownership (database.sql.owner): tenant (the default), user or none for one shared space
  --tenant-name <name>                      What a tenant is called (blocks.memberships.names.organization): organization (the default), workspace, team or another lowercase name
  --access <roles|catalog|provider|custom>  Auth and permissions (blocks.permissions.model): roles (the default), catalog, provider or custom
  --id-type <uuid|text|bigint|integer>      The type of the permissions block's ids (blocks.permissions.idType): uuid (the default), text, bigint or integer
  --api <none|api>                          API schema (database.sql.api): none (the default) or api for security invoker wrappers in an api schema
  --integration <integration,...>           Integrations to add next to the detected ones: next, hono, orpc, edge, expo, mcp, client, react
  --package <dir>                           Workspace package to write to, relative to --cwd
  --workflow <pg-delta|migra|migrations>    How the SQL modules reach the database: pg-delta (the default), migra or migrations
  --from <url|name|code|file>               Where the project starts: a postgres:// URL (reads its schema into supabase/snapshot.json), or a preset, design code, URL or file like --preset
  --preset <name|code|url|file>             A named preset, a design code from /create, its URL or a downloaded design file: the config starts from it, and init writes its modules and lib/blocks.ts
  --lite                                    Run on Supabase Lite: install @supabase/lite and use its CLI in the next steps
  --content-mapper                          Serve the schema types through the TypeScript 7.1 content mapper: sets gen.contentMapper and adds it to tsconfig.json
  --dry-run                                 Print what would change, with a diff, and write nothing
  --check                                   Write nothing; exit 1 with a diff when a file would change
  --force                                   Overwrite files the CLI did not generate

Global options
  --cwd <dir>            Project directory
  --config <file>        Config file, relative to --cwd
  --env <name>           Config environment to apply ($env.<name> or $<name>). Defaults to $BETTER_SUPABASE_ENV, then ci when $CI is set
  --json                 Print one JSON document on stdout; errors as Problem Details. On by default in agent mode
  --agent <auto|yes|no>  Agent mode (JSON output, no prompts, consent for destructive work): auto detects a coding agent, yes or no decide. Defaults to $BETTER_SUPABASE_AGENT, then auto
  --confirm <token>      The token from a consent_required result, passed once the user agreed
  -y, --yes              Ask nothing; use the flags and the defaults
  --no-color             Print no colors, like $NO_COLOR
  --debug                Print stack traces, the commands the CLI runs, and timings on stderr
  -h, --help             Show help

Examples
  # Asks what to set up, then writes the files
  $ better-supabase init
  # Starts from a preset without asking
  $ better-supabase init --preset saas --yes

Side effects: Writes files.
Docs: https://bettersupabase.com/docs/cli/init
"
`;

exports[`help > documents mcp 1`] = `
"Usage: better-supabase mcp [options]

Serves the CLI to coding agents as an MCP server on stdio: read-only tools, and file writes with --allow-writes and the user's consent

Options
  --allow-writes  Add the tools that write files (gen, sql_sync, apply, add); each call still needs the user's consent token

Global options
  --cwd <dir>            Project directory
  --config <file>        Config file, relative to --cwd
  --env <name>           Config environment to apply ($env.<name> or $<name>). Defaults to $BETTER_SUPABASE_ENV, then ci when $CI is set
  --json                 Print one JSON document on stdout; errors as Problem Details. On by default in agent mode
  --agent <auto|yes|no>  Agent mode (JSON output, no prompts, consent for destructive work): auto detects a coding agent, yes or no decide. Defaults to $BETTER_SUPABASE_AGENT, then auto
  --confirm <token>      The token from a consent_required result, passed once the user agreed
  -y, --yes              Ask nothing; use the flags and the defaults
  --no-color             Print no colors, like $NO_COLOR
  --debug                Print stack traces, the commands the CLI runs, and timings on stderr
  -h, --help             Show help

Examples
  # Starts the read-only server; add it to the agent's MCP config
  $ better-supabase mcp
  # Adds gen, upgrade, add and remove, each behind a consent token
