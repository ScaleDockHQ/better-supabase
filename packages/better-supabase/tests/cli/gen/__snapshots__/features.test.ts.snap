"// @generated by better-supabase gen. Do not edit; run \`better-supabase gen\` instead.

"use client";

import { createElement, type ReactNode } from "react";

import { createRecordProvider } from "better-supabase/react";

import {
  addCustomerComments,
  removeCustomerComments,
  startCustomerSla,
  applyCustomerTags,
  removeCustomerTags,
} from "./customer-actions.ts";
import { customerFeature } from "./customer-feature.ts";

const kit = createRecordProvider(customerFeature);

const writes = {
  comments: {
    add: addCustomerComments,
    remove: removeCustomerComments,
  },
  sla: {
    start: startCustomerSla,
  },
  tags: {
    apply: applyCustomerTags,
    remove: removeCustomerTags,
  },
};

export type CustomerRecordProviderProps = Omit<
  Parameters<typeof kit.RecordProvider>[0],
  "writes"
>;

/**
 * Holds a customer's sections for its children and follows \`topic\`.
 * Writes run as the generated Server Actions.
 */
export function CustomerRecordProvider(
  props: CustomerRecordProviderProps,
): ReactNode {
  return createElement(kit.RecordProvider, { ...props, writes });
}

/** The customer record context: \`{ state, actions, meta }\`. */
export const useCustomerRecord = kit.useRecord;
"
`;

