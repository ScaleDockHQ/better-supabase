"// @generated by better-supabase gen. Do not edit; run \`better-supabase gen\` instead.

import { accessBlock } from "better-supabase/blocks/access";
import { commentsBlock } from "better-supabase/blocks/comments";
import { defineRecordFeature } from "better-supabase/records";
import { slaBlock } from "better-supabase/blocks/sla";
import { tagsBlock } from "better-supabase/blocks/tags";

import { blockConfig, permissions } from "../../blocks.generated.ts";

/**
 * The customer record page: a section for each installed block that adds one.
 * Pass it to \`recordServer\`, \`recordQueries\` or \`createRecordProvider\`.
 */
export const customerFeature = defineRecordFeature({
  type: "customer",
  blocks: {
    comments: commentsBlock,
    sla: slaBlock,
    tags: tagsBlock,
  },
  config: blockConfig,
  permissions,
  access: accessBlock,
});
