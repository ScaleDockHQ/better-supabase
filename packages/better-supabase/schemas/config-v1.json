{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/better-supabase/schemas/config-v1.json",
  "title": "better-supabase config",
  "description": "Configuration for better-supabase.config.ts (or .json).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "source": {
      "description": "Where codegen reads the database from. Without any of these, $DATABASE_URL and then the local stack are used.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dbUrl": {
          "type": "string",
          "description": "Postgres connection string."
        },
        "projectRef": {
          "type": "string",
          "description": "Hosted project ref, read through the Management API read-only SQL endpoint."
        },
        "accessToken": {
          "type": "string",
          "description": "Management API token for projectRef. Defaults to $SUPABASE_ACCESS_TOKEN."
        },
        "snapshot": {
          "type": "string",
          "description": "Read a saved introspection snapshot instead of connecting."
        }
      }
    },
    "schemas": {
      "description": "Postgres schemas to generate.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": ["public"]
    },
    "casing": {
      "$ref": "#/$defs/casing",
      "default": "snake"
    },
    "tables": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "casing": {
            "$ref": "#/$defs/casing"
          },
          "exclude": {
            "type": "boolean"
          },
          "serviceRole": {
            "type": "boolean",
            "description": "Only service_role reaches the table. Models are still generated; doctor (BS106) checks that anon and authenticated have no grants."
          },
          "relations": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "insertOptional": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Database names of not-null columns an insert may leave out because the database fills them, for example from a before insert trigger."
          }
        }
      }
    },
    "output": {
      "type": "string",
      "description": "Main generated module.",
      "default": "src/lib/supabase/generated.ts"
    },
    "postgrestVersion": {
      "type": "string",
      "description": "PostgREST major version written to database.types.ts.",
      "default": "13"
    },
    "codecs": {
      "description": "Runtime types for timestamps, int8 and numeric columns.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timestamptz": {
          "enum": ["string", "instant"],
          "default": "string"
        },
        "int8": {
          "enum": ["number", "string", "bigint"],
          "default": "number"
        },
        "numeric": {
          "enum": ["number", "string"],
          "default": "number"
        }
      }
    },
    "relations": {
      "description": "How generated relations are typed.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nullableUnderRls": {
          "type": "boolean",
          "description": "Type to-one includes of tables with row level security as nullable, since a policy can hide the related row.",
          "default": false
        }
      }
    },
    "json": {
      "description": "Types for jsonb columns, keyed by `table.column`.",
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "required": ["import"],
            "additionalProperties": false,
            "properties": {
              "import": {
                "type": "string",
                "description": "`./path.ts#TypeName`"
              },
              "schema": {
                "type": "object",
                "description": "JSON Schema enforced by `sql add jsonb-schemas` (pg_jsonschema)."
              }
            }
          },
          {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "description": "Inline TypeScript type."
              },
              "schema": {
                "type": "object",
                "description": "JSON Schema enforced by `sql add jsonb-schemas` (pg_jsonschema)."
              }
            }
          }
        ]
      }
    },
    "generators": {
      "description": "Generator plugins. Only available in better-supabase.config.ts.",
      "type": "array"
    },
    "plugins": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timestamps": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "createdAt": {
                  "type": "string"
                },
                "updatedAt": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "softDelete": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "column": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "tenant": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "column": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "actor": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "createdBy": {
                  "type": "string"
                },
                "updatedBy": {
                  "type": "string"
                }
              }
            }
          ]
        }
      }
    },
    "claims": {
      "description": "Claim names shared by the SQL modules, codegen and runtime defaults (PermDock's claim contract).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant": {
          "type": "string",
          "description": "Top-level claim holding the active tenant id. Defaults to `tenant_id`."
        },
        "scope": {
          "type": "string",
          "description": "`scope` of the tenant entries in the `memberships` claim. Defaults to `tenant`."
        },
        "features": {
          "type": "string",
          "description": "Claim holding plan features per tenant. Defaults to `features`."
        }
      }
    },
    "buckets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["path"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "public": {
            "type": "boolean"
          },
          "path": {
            "description": "Path template, e.g. `{organizationId}/{customerId}/logo.webp`, or several for a bucket that stores objects in more than one layout. A last segment `{...rest}` matches one or more segments.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            ]
          },
          "policy": {
            "oneOf": [
              {
                "enum": ["tenant", "owner", "public", "none"]
              },
              {
                "type": "object",
                "description": "Policies that call PermDock's permitted_<scope>_ids or permdock_has helpers.",
                "required": ["permdock", "scope"],
                "additionalProperties": false,
                "properties": {
                  "permdock": {
                    "type": "object",
                    "required": ["read", "write"],
                    "additionalProperties": false,
                    "properties": {
                      "read": {
                        "type": "string"
                      },
                      "list": {
                        "type": "string"
                      },
                      "write": {
                        "type": "string"
                      },
                      "delete": {
                        "type": "string"
                      }
                    }
                  },
                  "scope": {
                    "type": "string"
                  },
                  "segment": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "schema": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "fileSizeLimit": {
            "type": "string"
          },
          "allowedMimeTypes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "versioning": {
            "description": "Keep earlier object versions. bucket.apply() sets it.",
            "type": "boolean"
          },
          "lifecycle": {
            "description": "When noncurrent versions expire. Needs versioning: true.",
            "type": "object",
            "additionalProperties": false,
            "required": ["rules"],
            "properties": {
              "rules": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1000,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["noncurrentVersionExpiration"],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "status": {
                      "enum": ["Enabled", "Disabled"]
                    },
                    "noncurrentVersionExpiration": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["noncurrentDays"],
                      "properties": {
                        "noncurrentDays": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "newerNoncurrentVersions": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 100
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "topics": {
      "description": "Realtime topic templates.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "sensitive": {
      "description": "Columns guarded by the noSensitiveSelect rule (`table.column` or `schema.table.column`).",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "storagePaths": {
      "description": "Text columns holding a storage object path (`table.column` or `schema.table.column`), mapped to a `buckets` key or bucket id. Typed as `StoragePath<'bucket-id'>`.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "functions": {
      "description": "Function results gen may type as not null, keyed by function name. Results are nullable by default.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "notNull": {
            "description": "true for the whole result, or the returns table columns that are never null.",
            "oneOf": [
              {
                "const": true
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        }
      }
    },
    "expose": {
      "description": "Data API grants keyed by `table` or `schema.table`: privileges for authenticated, or per role. Written by the `grants` SQL module and checked by doctor (BS106).",
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/privileges"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "anon": {
                "$ref": "#/$defs/privileges"
              },
              "authenticated": {
                "$ref": "#/$defs/privileges"
              }
            }
          }
        ]
      }
    },
    "readSets": {
      "description": "Modules exporting `defineReadSet` results. `gen` compiles them into the `read-sets` SQL module.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entitlements": {
      "description": "Where the `entitlements` SQL module finds each tenant's entitlements: a Stripe customer, a plan catalog or your own function.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "customer": {
          "description": "`table.column` or `schema.table.column` holding the Stripe customer id.",
          "type": "string",
          "default": "organizations.stripe_customer_id"
        },
        "key": {
          "description": "The tenant id column of that table.",
          "type": "string",
          "default": "id"
        },
        "permdock": {
          "description": "With a PermDock manifest, read PermDock's memberships for this scope instead of better_supabase.memberships; false keeps the module's table.",
          "oneOf": [
            {
              "const": false
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "scope": {
                  "type": "string",
                  "description": "The PermDock scope tenants are. Defaults to the manifest's root scope, the rls.scopes entry without within."
                }
              }
            }
          ]
        },
        "source": {
          "description": "Where each tenant's entitlements come from: \"stripe-sync\" (the Stripe Sync Engine, the default), \"custom\" (your own better_supabase.tenant_entitlements), or a plan catalog in your tables.",
          "oneOf": [
            { "enum": ["stripe-sync", "custom"] },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["plans"],
              "properties": {
                "plans": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["subscriptions", "features"],
                  "properties": {
                    "subscriptions": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["table", "tenant", "plan"],
                      "properties": {
                        "table": { "type": "string" },
                        "tenant": { "type": "string" },
                        "plan": { "type": "string" },
                        "status": { "type": "string" },
                        "activeStatuses": {
                          "type": "array",
                          "items": { "type": "string" }
                        }
                      }
                    },
                    "features": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["table", "plan", "feature"],
                      "properties": {
                        "table": { "type": "string" },
                        "plan": { "type": "string" },
                        "feature": { "type": "string" },
                        "included": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "claim": {
          "description": "The shape of the features claim feature_claims writes: false for {}, or maxTenants (at most that many tenants) and keys (short codes for feature keys).",
          "oneOf": [
            { "const": false },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "maxTenants": { "type": "integer", "minimum": 1 },
                "keys": {
                  "type": "object",
                  "additionalProperties": { "type": "string" }
                }
              }
            }
          ]
        }
      }
    },
    "permdock": {
      "description": "Where PermDock's JSON outputs are.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manifest": {
          "description": "What `permdock supabase inspect --out` writes.",
          "type": "string",
          "default": "permdock.manifest.json"
        },
        "catalog": {
          "description": "What `permdock catalog` writes.",
          "type": "string",
          "default": "permissions.catalog.json"
        }
      }
    },
    "vectorSearch": {
      "description": "Embedding columns keyed by `table` or `schema.table`. The `vector-search` SQL module writes `search_<table>(query, k)` for each.",
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "description": "The embedding column."
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["column"],
            "properties": {
              "column": {
                "type": "string"
              },
              "distance": {
                "enum": ["cosine", "l2", "inner_product"],
                "default": "cosine"
              },
              "type": { "enum": ["vector", "halfvec"], "default": "vector" },
              "key": {
                "type": "string",
                "default": "id",
                "description": "The primary key column db.$search({ score: true }) merges by."
              },
              "hybrid": {
                "type": "object",
                "additionalProperties": false,
                "required": ["tsvector"],
                "description": "Fuses a full-text ranking over a tsvector column with the vector ranking (reciprocal rank fusion).",
                "properties": {
                  "tsvector": { "type": "string" },
                  "config": { "type": "string", "default": "simple" },
                  "k": { "type": "integer", "minimum": 1, "default": 60 }
                }
              },
              "boost": {
                "type": "string",
                "description": "A SQL expression over the row t the score is multiplied by."
              },
              "prefilter": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Columns db.$search({ filter }) narrows before ranking."
              },
              "predicate": {
                "type": "string",
                "description": "A SQL condition over the row t every candidate must meet, applied before ranking."
              },
              "boostMode": {
                "enum": ["multiply", "add"],
                "description": "How boost combines with the score. Defaults to multiply."
              },
              "order": {
                "type": "string",
                "description": "A SQL order by list over the row t that breaks score ties."
              }
            }
          }
        ]
      }
    },
    "realtime": {
      "description": "Live query change broadcasts.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tables": {
          "description": "Tables that broadcast change signals (`table` or `schema.table`). Install with `better-supabase sql add realtime-tables`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "global": {
          "description": "Tables in `tables` without a tenant column, which broadcast on one topic for every signed-in user.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sql": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dir": {
          "type": "string",
          "default": "supabase/schemas"
        },
        "prefix": {
          "type": "string",
          "default": "900_better_supabase"
        },
        "testsDir": {
          "type": "string",
          "default": "supabase/tests"
        },
        "modules": {
          "description": "The SQL modules to keep in sync: a list of names, or an object keyed by module name whose values set the module mode, names, permission keys and options.",
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "object",
              "properties": {
                "access": {
                  "$ref": "#/$defs/accessModule"
                }
              },
              "additionalProperties": {
                "$ref": "#/$defs/moduleConfig"
              }
            }
          ]
        }
      }
    },
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entry": {
          "type": "string",
          "default": "supabase/seed.ts"
        },
        "output": {
          "type": "string",
          "default": "supabase/seeds/000_better_supabase.sql"
        }
      }
    },
    "openapi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entry": {
          "type": "string",
          "default": "src/lib/openapi.ts"
        },
        "output": {
          "type": "string",
          "default": "openapi.json"
        }
      }
    },
    "doctor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ignore": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^BS\\d{3}$"
          }
        },
        "strict": {
          "type": "boolean"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "policyHelperLimit": {
          "type": "integer",
          "minimum": 1
        },
        "claimsLimit": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "$defs": {
    "stringRecord": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "moduleConfigProperties": {
      "mode": {
        "enum": ["managed", "adopt", "custom"],
        "default": "managed"
      },
      "schema": {
        "type": "string",
        "default": "better_supabase"
      },
      "tables": {
        "type": "object",
        "additionalProperties": {
          "type": ["string", "null"]
        }
      },
      "columns": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "null"]
          }
        }
      },
      "idType": {
        "type": "string"
      },
      "triggerPrefix": {
        "type": "string",
        "default": "bs_"
      },
      "permissions": {
        "$ref": "#/$defs/stringRecord"
      },
      "options": {
        "type": "object"
      },
      "api": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["schema"],
            "properties": {
              "schema": {
                "type": "string"
              },
              "functions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    },
    "moduleConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/$defs/moduleConfigProperties/mode"
        },
        "schema": {
          "$ref": "#/$defs/moduleConfigProperties/schema"
        },
        "tables": {
          "$ref": "#/$defs/moduleConfigProperties/tables"
        },
        "columns": {
          "$ref": "#/$defs/moduleConfigProperties/columns"
        },
        "idType": {
          "$ref": "#/$defs/moduleConfigProperties/idType"
        },
        "triggerPrefix": {
          "$ref": "#/$defs/moduleConfigProperties/triggerPrefix"
        },
        "permissions": {
          "$ref": "#/$defs/moduleConfigProperties/permissions"
        },
        "options": {
          "$ref": "#/$defs/moduleConfigProperties/options"
        },
        "api": {
          "$ref": "#/$defs/moduleConfigProperties/api"
        }
      }
    },
    "accessModule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/$defs/moduleConfigProperties/mode"
        },
        "schema": {
          "$ref": "#/$defs/moduleConfigProperties/schema"
        },
        "tables": {
          "$ref": "#/$defs/moduleConfigProperties/tables"
        },
        "columns": {
          "$ref": "#/$defs/moduleConfigProperties/columns"
        },
        "idType": {
          "$ref": "#/$defs/moduleConfigProperties/idType"
        },
        "triggerPrefix": {
          "$ref": "#/$defs/moduleConfigProperties/triggerPrefix"
        },
        "permissions": {
          "$ref": "#/$defs/moduleConfigProperties/permissions"
        },
        "options": {
          "$ref": "#/$defs/moduleConfigProperties/options"
        },
        "api": {
          "$ref": "#/$defs/moduleConfigProperties/api"
        },
        "model": {
          "enum": ["roles", "catalog", "permdock", "custom"],
          "default": "roles"
        },
        "roles": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "functions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "can": {
              "type": "string"
            },
            "tenantIdsWith": {
              "type": "string"
            },
            "isPlatform": {
              "type": "string"
            },
            "canUser": {
              "type": "string"
            },
            "canAssign": {
              "type": "string"
            },
            "permissionClaims": {
              "type": "string"
            }
          }
        },
        "platformClaim": {
          "type": "string",
          "default": "platform_permissions"
        },
        "disabled": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tenant": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["table", "id"],
                  "properties": {
                    "table": {
