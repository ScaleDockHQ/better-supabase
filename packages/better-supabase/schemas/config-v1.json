{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/better-supabase/schemas/config-v1.json",
  "title": "better-supabase config",
  "description": "Configuration for better-supabase.config.ts (or .json).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "source": {
      "description": "Where codegen reads the database from. Without any of these, $DATABASE_URL and then the local stack are used.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dbUrl": {
          "type": "string",
          "description": "Postgres connection string."
        },
        "projectRef": {
          "type": "string",
          "description": "Hosted project ref, read through the Management API read-only SQL endpoint."
        },
        "accessToken": {
          "type": "string",
          "description": "Management API token for projectRef. Defaults to $SUPABASE_ACCESS_TOKEN."
        },
        "snapshot": {
          "type": "string",
          "description": "Read a saved introspection snapshot instead of connecting."
        }
      }
    },
    "schemas": {
      "description": "Postgres schemas to generate.",
      "type": "array",
      "items": { "type": "string" },
      "default": ["public"]
    },
    "casing": { "$ref": "#/$defs/casing", "default": "snake" },
    "tables": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "casing": { "$ref": "#/$defs/casing" },
          "exclude": { "type": "boolean" },
          "serviceRole": {
            "type": "boolean",
            "description": "Only service_role reaches the table. Models are still generated; doctor (BS106) checks that anon and authenticated have no grants."
          },
          "relations": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "insertOptional": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Database names of not-null columns an insert may leave out because the database fills them, for example from a before insert trigger."
          }
        }
      }
    },
    "output": {
      "type": "string",
      "description": "Main generated module.",
      "default": "src/lib/supabase/generated.ts"
    },
    "postgrestVersion": {
      "type": "string",
      "description": "PostgREST major version written to database.types.ts.",
      "default": "13"
    },
    "codecs": {
      "description": "Runtime types for timestamps, int8 and numeric columns.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timestamptz": { "enum": ["string", "instant"], "default": "string" },
        "int8": { "enum": ["number", "string", "bigint"], "default": "number" },
        "numeric": { "enum": ["number", "string"], "default": "number" }
      }
    },
    "relations": {
      "description": "How generated relations are typed.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nullableUnderRls": {
          "type": "boolean",
          "description": "Type to-one includes of tables with row level security as nullable, since a policy can hide the related row.",
          "default": false
        }
      }
    },
    "json": {
      "description": "Types for jsonb columns, keyed by `table.column`.",
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "required": ["import"],
            "additionalProperties": false,
            "properties": {
              "import": {
                "type": "string",
                "description": "`./path.ts#TypeName`"
              },
              "schema": {
                "type": "object",
                "description": "JSON Schema enforced by `sql add jsonb-schemas` (pg_jsonschema)."
              }
            }
          },
          {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "description": "Inline TypeScript type."
              },
              "schema": {
                "type": "object",
                "description": "JSON Schema enforced by `sql add jsonb-schemas` (pg_jsonschema)."
              }
            }
          }
        ]
      }
    },
    "generators": {
      "description": "Generator plugins. Only available in better-supabase.config.ts.",
      "type": "array"
    },
    "plugins": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timestamps": {
          "oneOf": [
            { "type": "boolean" },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "createdAt": { "type": "string" },
                "updatedAt": { "type": "string" }
              }
            }
          ]
        },
        "softDelete": {
          "oneOf": [
            { "type": "boolean" },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": { "column": { "type": "string" } }
            }
          ]
        },
        "tenant": {
          "oneOf": [
            { "type": "boolean" },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "column": { "type": "string" }
              }
            }
          ]
        },
        "actor": {
          "oneOf": [
            { "type": "boolean" },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "createdBy": { "type": "string" },
                "updatedBy": { "type": "string" }
              }
            }
          ]
        }
      }
    },
    "claims": {
      "description": "Claim names shared by the SQL modules, codegen and runtime defaults (PermDock's claim contract).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant": {
          "type": "string",
          "description": "Top-level claim holding the active tenant id. Defaults to `tenant_id`."
        },
        "scope": {
          "type": "string",
          "description": "`scope` of the tenant entries in the `memberships` claim. Defaults to `tenant`."
        },
        "features": {
          "type": "string",
          "description": "Claim holding plan features per tenant. Defaults to `features`."
        }
      }
    },
    "buckets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["path"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "public": { "type": "boolean" },
          "path": {
            "description": "Path template, e.g. `{organizationId}/{customerId}/logo.webp`, or several for a bucket that stores objects in more than one layout. A last segment `{...rest}` matches one or more segments.",
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "type": "string" }, "minItems": 1 }
            ]
          },
          "policy": {
            "oneOf": [
              { "enum": ["tenant", "owner", "public", "none"] },
              {
                "type": "object",
                "description": "Policies that call PermDock's permitted_<scope>_ids or permdock_has helpers.",
                "required": ["permdock", "scope"],
                "additionalProperties": false,
                "properties": {
                  "permdock": {
                    "type": "object",
                    "required": ["read", "write"],
                    "additionalProperties": false,
                    "properties": {
                      "read": { "type": "string" },
                      "list": { "type": "string" },
                      "write": { "type": "string" },
                      "delete": { "type": "string" }
                    }
                  },
                  "scope": { "type": "string" },
                  "segment": { "type": "integer", "minimum": 1 },
                  "schema": { "type": "string" }
                }
              }
            ]
          },
          "fileSizeLimit": { "type": "string" },
          "allowedMimeTypes": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "topics": {
      "description": "Realtime topic templates.",
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "sensitive": {
      "description": "Columns guarded by the noSensitiveSelect rule (`table.column` or `schema.table.column`).",
      "type": "array",
      "items": { "type": "string" }
    },
    "storagePaths": {
      "description": "Text columns holding a storage object path (`table.column` or `schema.table.column`), mapped to a `buckets` key or bucket id. Typed as `StoragePath<'bucket-id'>`.",
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "functions": {
      "description": "Function results gen may type as not null, keyed by function name. Results are nullable by default.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "notNull": {
            "description": "true for the whole result, or the returns table columns that are never null.",
            "oneOf": [
              { "const": true },
              { "type": "array", "items": { "type": "string" } }
            ]
          }
        }
      }
    },
    "expose": {
      "description": "Data API grants keyed by `table` or `schema.table`: privileges for authenticated, or per role. Written by the `grants` SQL module and checked by doctor (BS106).",
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/$defs/privileges" },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "anon": { "$ref": "#/$defs/privileges" },
              "authenticated": { "$ref": "#/$defs/privileges" }
            }
          }
        ]
      }
    },
    "readSets": {
      "description": "Modules exporting `defineReadSet` results. `gen` compiles them into the `read-sets` SQL module.",
      "type": "array",
      "items": { "type": "string" }
    },
    "entitlements": {
      "description": "Where the `entitlements` SQL module finds each tenant's Stripe customer.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "customer": {
          "description": "`table.column` or `schema.table.column` holding the Stripe customer id.",
          "type": "string",
          "default": "organizations.stripe_customer_id"
        },
        "key": {
          "description": "The tenant id column of that table.",
          "type": "string",
          "default": "id"
        },
        "permdock": {
          "description": "With a PermDock manifest, read PermDock's memberships for this scope instead of better_supabase.memberships; false keeps the module's table.",
          "oneOf": [
            { "const": false },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "scope": {
                  "type": "string",
                  "description": "The PermDock scope tenants are. Defaults to the manifest's root scope, the rls.scopes entry without within."
                }
              }
            }
          ]
        }
      }
    },
    "permdock": {
      "description": "Where PermDock's JSON outputs are.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manifest": {
          "description": "What `permdock supabase inspect --out` writes.",
          "type": "string",
          "default": "permdock.manifest.json"
        },
        "catalog": {
          "description": "What `permdock catalog` writes.",
          "type": "string",
          "default": "permissions.catalog.json"
        }
      }
    },
    "vectorSearch": {
      "description": "Embedding columns keyed by `table` or `schema.table`. The `vector-search` SQL module writes `search_<table>(query, k)` for each.",
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "string", "description": "The embedding column." },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["column"],
            "properties": {
              "column": { "type": "string" },
              "distance": {
                "enum": ["cosine", "l2", "inner_product"],
                "default": "cosine"
              }
            }
          }
        ]
      }
    },
    "realtime": {
      "description": "Live query change broadcasts.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tables": {
          "description": "Tables that broadcast change signals (`table` or `schema.table`). Install with `better-supabase sql add realtime-tables`.",
          "type": "array",
          "items": { "type": "string" }
        },
        "global": {
          "description": "Tables in `tables` without a tenant column, which broadcast on one topic for every signed-in user.",
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "sql": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dir": { "type": "string", "default": "supabase/schemas" },
        "prefix": { "type": "string", "default": "900_better_supabase" },
        "testsDir": { "type": "string", "default": "supabase/tests" },
        "modules": { "type": "array", "items": { "type": "string" } }
      }
    },
    "blocks": {
      "type": "object",
      "description": "How each SQL module maps onto the database, keyed by module name.",
      "properties": {
        "access": { "$ref": "#/$defs/accessBlock" }
      },
      "additionalProperties": { "$ref": "#/$defs/blockModule" }
    },
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entry": { "type": "string", "default": "supabase/seed.ts" },
        "output": {
          "type": "string",
          "default": "supabase/seeds/000_better_supabase.sql"
        }
      }
    },
    "openapi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entry": { "type": "string", "default": "src/lib/openapi.ts" },
        "output": { "type": "string", "default": "openapi.json" }
      }
    },
    "doctor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ignore": {
          "type": "array",
          "items": { "type": "string", "pattern": "^BS\\d{3}$" }
        },
        "strict": { "type": "boolean" },
        "sources": { "type": "array", "items": { "type": "string" } },
        "policyHelperLimit": { "type": "integer", "minimum": 1 },
        "claimsLimit": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "$defs": {
    "stringRecord": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "blockModuleProperties": {
      "mode": { "enum": ["managed", "adopt", "custom"], "default": "managed" },
      "schema": { "type": "string", "default": "better_supabase" },
      "tables": {
        "type": "object",
        "additionalProperties": { "type": ["string", "null"] }
      },
      "columns": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": { "type": ["string", "null"] }
        }
      },
      "idType": { "type": "string" },
      "triggerPrefix": { "type": "string", "default": "bs_" },
      "permissions": { "$ref": "#/$defs/stringRecord" },
      "options": { "type": "object" }
    },
    "blockModule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "$ref": "#/$defs/blockModuleProperties/mode" },
        "schema": { "$ref": "#/$defs/blockModuleProperties/schema" },
        "tables": { "$ref": "#/$defs/blockModuleProperties/tables" },
        "columns": { "$ref": "#/$defs/blockModuleProperties/columns" },
        "idType": { "$ref": "#/$defs/blockModuleProperties/idType" },
        "triggerPrefix": {
          "$ref": "#/$defs/blockModuleProperties/triggerPrefix"
        },
        "permissions": { "$ref": "#/$defs/blockModuleProperties/permissions" },
        "options": { "$ref": "#/$defs/blockModuleProperties/options" }
      }
    },
    "accessBlock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "$ref": "#/$defs/blockModuleProperties/mode" },
        "schema": { "$ref": "#/$defs/blockModuleProperties/schema" },
        "tables": { "$ref": "#/$defs/blockModuleProperties/tables" },
        "columns": { "$ref": "#/$defs/blockModuleProperties/columns" },
        "idType": { "$ref": "#/$defs/blockModuleProperties/idType" },
        "triggerPrefix": {
          "$ref": "#/$defs/blockModuleProperties/triggerPrefix"
        },
        "permissions": { "$ref": "#/$defs/blockModuleProperties/permissions" },
        "options": { "$ref": "#/$defs/blockModuleProperties/options" },
        "model": {
          "enum": ["roles", "catalog", "permdock", "custom"],
          "default": "roles"
        },
        "roles": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "functions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "can": { "type": "string" },
            "tenantIdsWith": { "type": "string" },
            "isPlatform": { "type": "string" },
            "canUser": { "type": "string" },
            "canAssign": { "type": "string" },
            "permissionClaims": { "type": "string" }
          }
        },
        "platformClaim": {
          "type": "string",
          "default": "platform_permissions"
        },
        "disabled": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tenant": { "type": "string" },
            "tenantKey": { "type": "string" },
            "user": { "type": "string" },
            "userKey": { "type": "string" }
          }
        },
        "activeTenant": {
          "oneOf": [
            { "enum": ["claim", "resolver"] },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["profileColumn"],
              "properties": {
                "profileColumn": { "type": "string" },
                "key": { "type": "string" }
              }
            }
          ]
        },
        "permdock": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema": { "type": "string" },
            "scope": { "type": "string" }
          }
        }
      }
    },
    "casing": { "enum": ["snake", "camel"] },
    "privileges": {
      "type": "array",
      "items": { "enum": ["select", "insert", "update", "delete"] }
    }
  }
}
