{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@better-supabase/typescript-config/base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2025", "ESNext.Disposable", "ESNext.Temporal", "DOM"],
    "types": ["node"],
    // The items import the app's files through the `@/` alias, as shadcn
    // rewrites it on install. The stubs stand in for what `better-supabase
    // init` writes (`lib/supabase/*`).
    "paths": {
      "@/lib/supabase/*": ["./stubs/lib/supabase/*"],
      "@/lib/*": ["./items/lib/*"],
      "@/hooks/*": ["./items/hooks/*"]
    }
  },
  "include": ["items", "stubs", "tests", "env.d.ts", "vitest.config.ts"]
}
