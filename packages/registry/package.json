    "@valibot/to-json-schema": "catalog:",
    "ai": "catalog:",
    "better-supabase": "workspace:*",
    "expo": "catalog:",
    "expo-notifications": "catalog:",
    "hono": "catalog:",
    "next": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "server-only": "catalog:",
    "shadcn": "catalog:",
    "temporal-polyfill": "catalog:",
    "typescript": "catalog:",
    "valibot": "catalog:",
    "vitest": "catalog:"
  }
}
