# Keys only. `pnpm env:pull` writes the hosted values to .env.local, and
# `pnpm env:local` writes the local stack values to .env.development.local.

# Public site URL for canonical links, OG images and sitemaps.
NEXT_PUBLIC_SITE_URL=

# apps/marketing: where `next dev` proxies /docs.
DOCS_ORIGIN=
# Optional, server-only: the Supabase OAuth app behind "Deploy to Supabase"
# on /create, and the secret (32+ characters) that encrypts its session cookie.
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=
SUPABASE_OAUTH_COOKIE_SECRET=
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# apps/docs Ask AI. On Vercel the OIDC token authenticates the AI Gateway.
AI_GATEWAY_API_KEY=
VERCEL_OIDC_TOKEN=

# ReUI registry and MCP server (a team Shared Environment Variable).
REUI_LICENSE_KEY=

# The local stack for the integration suites and the Next.js example. The CLI
# picks the ports for each checkout, so `pnpm env:local` writes these.
SUPABASE_URL=
SUPABASE_DB_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only; the Next.js example deletes accounts with it.
SUPABASE_SECRET_KEY=
# native, docker or podman for the stack engine, legacy without it. Tests the
# stack engine fails skip themselves when it is set to one of the first three.
SUPABASE_RUNTIME=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: the Supabase World in the Next.js example.
WORKFLOW_POSTGRES_URL=

# Server-only: the bearer token the examples' cron routes require.
CRON_SECRET=
# Optional, server-only: apps/examples/nextjs signs its precomputed flags and
# guards Flags Explorer with it.
FLAGS_SECRET=
# apps/examples/eve: the inbox channel's bearer token and the app's own URL.
INBOX_BOT_SECRET=
APP_URL=
# apps/examples/nextjs: delays every Supabase request by this many
# milliseconds for the e2e latency project. Never set it in production.
BS_FETCH_DELAY_MS=
# 1 builds the Next.js apps with the testing API that `instant()` needs.
EXPOSE_TESTING_API=

# Signs and verifies Turbo remote cache artifacts.
TURBO_REMOTE_CACHE_SIGNATURE_KEY=
