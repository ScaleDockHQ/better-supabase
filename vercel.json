{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "git": {
    "deploymentEnabled": {
      "*": false,
      "**": false,
      "changeset-release/**": false,
      "main": true
    }
  },
  "services": {
    "docs": {
      "root": "apps/docs",
      "framework": "nextjs",
      "installCommand": "pnpm install --frozen-lockfile --filter '{.}...'",
      "buildCommand": "cd ../.. && pnpm exec turbo run build --filter=docs",
      "ignoreCommand": "npx turbo-ignore@2.11.6 docs --fallback=HEAD^1",
      "rewrites": [
        {
          "source": "/docs/_next/:path*",
          "destination": "/_next/:path*"
        }
      ]
    },
    "marketing": {
      "root": "apps/marketing",
      "framework": "nextjs",
      "installCommand": "pnpm install --frozen-lockfile --filter '{.}...'",
      "buildCommand": "cd ../.. && pnpm exec turbo run build --filter=marketing",
      "ignoreCommand": "npx turbo-ignore@2.11.6 marketing --fallback=HEAD^1"
    }
  },
  "rewrites": [
    {
      "source": "/docs",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/docs/(.*)",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/api/search",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/llms.txt",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/llms-full.txt",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/llms.mdx/(.*)",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/mcp",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/149e9513-01fa-4fb0-aad4-566afd725d1b/(.*)",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/_next/(.*)",
      "destination": {
        "service": "marketing"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "marketing"
      }
    }
  ]
}
