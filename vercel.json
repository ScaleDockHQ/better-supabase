{
  "services": {
    "docs": {
      "root": "apps/docs",
      "framework": "nextjs",
      "installCommand": "corepack enable && corepack pnpm@11.21.0 install",
      "buildCommand": "(cd ../../packages/better-supabase && node --run build) && next build",
      "rewrites": [
        {
          "source": "/docs/_next/:path*",
          "destination": "/_next/:path*"
        }
      ]
    },
    "marketing": {
      "root": "apps/marketing",
      "framework": "nextjs",
      "installCommand": "corepack enable && corepack pnpm@11.21.0 install",
      "buildCommand": "next build"
    }
  },
  "rewrites": [
    {
      "source": "/docs",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/docs/(.*)",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/api/search",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/llms.txt",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/llms-full.txt",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/llms.mdx/(.*)",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/_next/(.*)",
      "destination": {
        "service": "marketing"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "marketing"
      }
    }
  ]
}
