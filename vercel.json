{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "docs": {
      "root": "apps/docs",
      "framework": "nextjs",
      "installCommand": "corepack enable && corepack pnpm@11.21.0 install",
      "buildCommand": "cd ../.. && corepack pnpm@11.21.0 exec turbo run build --filter=docs",
      "ignoreCommand": "npx turbo-ignore@2.11.5 docs --fallback=HEAD^1",
      "rewrites": [
        {
          "source": "/docs/_next/:path*",
          "destination": "/_next/:path*"
        }
      ]
    },
    "marketing": {
      "root": "apps/marketing",
      "framework": "nextjs",
      "installCommand": "corepack enable && corepack pnpm@11.21.0 install",
      "buildCommand": "cd ../.. && corepack pnpm@11.21.0 exec turbo run build --filter=marketing",
      "ignoreCommand": "npx turbo-ignore@2.11.5 marketing --fallback=HEAD^1"
    }
  },
  "rewrites": [
    {
      "source": "/docs",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/docs/(.*)",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/api/search",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/llms.txt",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/llms-full.txt",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/llms.mdx/(.*)",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/mcp",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/_next/(.*)",
      "destination": {
        "service": "marketing"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "marketing"
      }
    }
  ]
}
