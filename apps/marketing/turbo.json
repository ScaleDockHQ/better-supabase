{
  "$schema": "https://v2-11-7.turborepo.dev/schema.json",
  "extends": ["//"],
  "tags": ["app"],
  "tasks": {
    "dev": {
      "dependsOn": ["//#catalog", "//#recipes"],
      "passThroughEnv": [
        "PORT",
        "DOCS_ORIGIN",
        "RESEND_API_KEY",
        "CONTACT_FROM_EMAIL"
      ]
    },
    "build": {
      "dependsOn": ["^build", "//#catalog", "//#recipes"],
      "env": [
        "EXPOSE_TESTING_API",
        "DOCS_ORIGIN",
        "NEXT_PUBLIC_SITE_URL",
        "RESEND_API_KEY",
        "CONTACT_FROM_EMAIL",
        "BSB_BUILD_SCOPE",
        "VERCEL_ENV"
      ]
    },
    "dev:portless": {
      "dependsOn": ["//#catalog", "//#recipes"],
      "passThroughEnv": [
        "PORT",
        "DOCS_ORIGIN",
        "RESEND_API_KEY",
        "CONTACT_FROM_EMAIL"
      ]
    },
    "lint": {
      "dependsOn": ["transit", "//#catalog", "//#recipes"]
    },
    "typecheck": {
      "dependsOn": ["$TURBO_EXTENDS$", "//#catalog", "//#recipes"]
    },
    "test": {
      "dependsOn": ["$TURBO_EXTENDS$", "//#catalog", "//#recipes"],
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/packages/registry/registry.json"
      ]
    }
  }
}
