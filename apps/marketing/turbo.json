{
  "$schema": "https://v2-11-6.turborepo.dev/schema.json",
  "extends": ["//"],
  "tags": ["app"],
  "tasks": {
    "dev": {
      "dependsOn": ["//#catalog"],
      "passThroughEnv": ["PORT", "DOCS_ORIGIN"]
    },
    "build": {
      "dependsOn": ["^build", "//#catalog"],
      "env": ["DOCS_ORIGIN", "NEXT_PUBLIC_SITE_URL"]
    },
    "dev:portless": {
      "dependsOn": ["//#catalog"],
      "passThroughEnv": ["PORT", "DOCS_ORIGIN"]
    },
    "lint": {
      "dependsOn": ["transit", "//#catalog"]
    },
    "typecheck": {
      "dependsOn": ["transit", "//#catalog"]
    },
    "test": {
      "dependsOn": ["transit", "//#catalog"]
    }
  }
}
