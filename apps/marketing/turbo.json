{
  "$schema": "https://v2-11-7.turborepo.dev/schema.json",
  "extends": ["//"],
  "tags": ["app"],
  "tasks": {
    "dev": {
      "dependsOn": ["//#catalog", "//#recipes"],
      "passThroughEnv": [
        "PORT",
        "DOCS_ORIGIN",
        "SUPABASE_OAUTH_CLIENT_ID",
        "SUPABASE_OAUTH_CLIENT_SECRET",
        "SUPABASE_OAUTH_COOKIE_SECRET"
      ]
    },
    "build": {
      "dependsOn": ["^build", "//#catalog", "//#recipes"],
      "env": [
        "DOCS_ORIGIN",
        "NEXT_PUBLIC_SITE_URL",
        "SUPABASE_OAUTH_CLIENT_ID",
        "SUPABASE_OAUTH_CLIENT_SECRET",
        "SUPABASE_OAUTH_COOKIE_SECRET"
      ]
    },
    "dev:portless": {
      "dependsOn": ["//#catalog", "//#recipes"],
      "passThroughEnv": [
        "PORT",
        "DOCS_ORIGIN",
        "SUPABASE_OAUTH_CLIENT_ID",
        "SUPABASE_OAUTH_CLIENT_SECRET",
        "SUPABASE_OAUTH_COOKIE_SECRET"
      ]
    },
    "lint": {
      "dependsOn": ["transit", "//#catalog", "//#recipes"]
    },
    "typecheck": {
      "dependsOn": ["transit", "//#catalog", "//#recipes"]
    },
    "test": {
      "dependsOn": ["transit", "//#catalog", "//#recipes"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/registry/registry.json"
      ]
    }
  }
}
