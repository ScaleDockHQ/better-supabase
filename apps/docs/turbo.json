{
  "$schema": "https://v2-11-6.turborepo.dev/schema.json",
  "extends": ["//"],
  "tags": ["app"],
  "tasks": {
    "build": {
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", ".source/**"],
      "env": ["NEXT_PUBLIC_SITE_URL"],
      "passThroughEnv": ["AI_GATEWAY_API_KEY"]
    },
    "dev": {
      "passThroughEnv": ["AI_GATEWAY_API_KEY"]
    },
    "dev:portless": {
      "passThroughEnv": ["AI_GATEWAY_API_KEY"]
    }
  }
}
