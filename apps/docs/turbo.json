{
  "$schema": "https://v2-11-7.turborepo.dev/schema.json",
  "extends": ["//"],
  "tags": ["app"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/CHANGELOG.md",
        "!tests/**",
        "!vitest.config.ts"
      ],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", ".source/**"],
      "env": [
        "EXPOSE_TESTING_API",
        "NEXT_PUBLIC_SITE_URL",
        "BSB_BUILD_SCOPE",
        "VERCEL_ENV"
      ],
      "passThroughEnv": ["AI_GATEWAY_API_KEY"]
    },
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "dev": {
      "passThroughEnv": ["AI_GATEWAY_API_KEY"]
    },
    "dev:portless": {
      "passThroughEnv": ["AI_GATEWAY_API_KEY"]
    }
  }
}
