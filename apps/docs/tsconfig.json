{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@better-supabase/typescript-config/next.json",
  "compilerOptions": {
    "declaration": false,
    "isolatedDeclarations": false,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
