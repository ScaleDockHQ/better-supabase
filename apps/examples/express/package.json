{
  "name": "@better-supabase/example-express",
  "version": "0.0.0",
  "private": true,
  "description": "An Express API on better-supabase/node with RLS-scoped repositories, role guards and Problem Details.",
  "type": "module",
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "gen": "better-supabase gen",
    "gen:check": "better-supabase gen --check",
    "lint": "oxlint",
