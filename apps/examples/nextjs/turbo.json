{
  "$schema": "https://v2-11-7.turborepo.dev/schema.json",
  "extends": ["//"],
  "tags": ["example"],
  "tasks": {
    "build": {
      "env": [
        "BSB_BUILD_SCOPE",
        "EXPOSE_TESTING_API",
        "FLAGS_SECRET",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_VAPID_PUBLIC_KEY",
        "VERCEL_ENV"
      ],
      "passThroughEnv": [
        "AI_GATEWAY_API_KEY",
        "CONNECT_*",
        "CRON_SECRET",
        "JOBS_BACKEND",
        "ASSISTANT_SANDBOX",
        "PDL_API_KEY",
        "NEXT_RUNTIME",
        "VERCEL_OIDC_TOKEN",
        "WORKFLOW_*"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env.production",
        "!**/*.md",
        "!tests/**",
        "!**/*.test.{ts,tsx}",
        "!vitest.config.ts"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "src/app/.well-known/workflow/**"
      ]
    },
    "lint": {
      "dependsOn": ["transit", "^build"]
    },
    "typecheck": {
      "dependsOn": ["transit", "^build"]
    },
    "dev:portless": {
      "passThroughEnv": [
        "AI_GATEWAY_API_KEY",
        "CONNECT_*",
        "CRON_SECRET",
        "JOBS_BACKEND",
        "ASSISTANT_SANDBOX",
        "PDL_API_KEY",
        "FLAGS_SECRET",
        "NEXT_PUBLIC_SUPABASE_*",
        "NEXT_RUNTIME",
        "VERCEL_OIDC_TOKEN",
        "WORKFLOW_*"
      ]
    }
  }
}
