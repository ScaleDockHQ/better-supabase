{
  "$schema": "https://v2-11-7.turborepo.dev/schema.json",
  "extends": ["//"],
  "tags": ["example"],
  "tasks": {
    "build": {
      "env": [
        "EXPOSE_TESTING_API",
        "FLAGS_SECRET",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_VAPID_PUBLIC_KEY"
      ],
      "passThroughEnv": [
        "AI_GATEWAY_API_KEY",
        "BS_FETCH_DELAY_MS",
        "CRON_SECRET",
        "PDL_API_KEY",
        "NEXT_RUNTIME",
        "WORKFLOW_*"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env.production"]
    },
    "lint": {
      "dependsOn": ["transit", "^build"]
    },
    "typecheck": {
      "dependsOn": ["transit", "^build"]
    },
    "dev:portless": {
      "passThroughEnv": [
        "AI_GATEWAY_API_KEY",
        "BS_FETCH_DELAY_MS",
        "CRON_SECRET",
        "PDL_API_KEY",
        "FLAGS_SECRET",
        "NEXT_PUBLIC_SUPABASE_*",
        "NEXT_RUNTIME",
        "WORKFLOW_*"
      ]
    }
  }
}
