{
  "$schema": "https://v2-11-6.turborepo.dev/schema.json",
  "extends": ["//"],
  "tags": ["example"],
  "tasks": {
    "build": {
      "env": [
        "EXPOSE_TESTING_API",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_SUPABASE_URL"
      ],
      "passThroughEnv": [
        "BS_FETCH_DELAY_MS",
        "CRON_SECRET",
        "NEXT_RUNTIME",
        "WORKFLOW_*"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env.production"]
    }
  }
}
