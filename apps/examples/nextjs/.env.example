NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: the VAPID public key for web push (the push card in Preferences).
# Generate a key pair with `npx web-push generate-vapid-keys`.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server-only, never NEXT_PUBLIC_: account deletion (bsb.deleteAccount) and the
# shared plan catalog (bsb.admin()) use it.
SUPABASE_SECRET_KEY=
# Optional: the /assistant sample answers with a scripted model without it.
# AI_GATEWAY_API_KEY=
# Optional, server-only: the People Data Labs key the enrichment provider uses
# (src/lib/supabase/providers.ts); lookups fail without it.
# PDL_API_KEY=
# Optional: "vercel" sends the settings page's test jobs to Vercel Queues, which
# push them to src/app/api/queues/settings-test (see vercel.json). Run
# `vercel env pull` first so the client gets an OIDC token locally.
# JOBS_BACKEND=
# Optional: "vercel" gives the /assistant sample a Vercel sandbox per chat, where
# it runs code after you approve it. Needs AI_GATEWAY_API_KEY and an OIDC token
# (`vercel env pull` writes VERCEL_OIDC_TOKEN locally).
# ASSISTANT_SANDBOX=
# Optional, server-only: Vercel Connect connector UIDs for the Integrations
# settings tab and mail sync. Connect signs in with the deployment's OIDC token;
# locally, `vercel env pull` writes VERCEL_OIDC_TOKEN.
# CONNECT_GMAIL_CONNECTOR=
# CONNECT_OUTLOOK_CONNECTOR=
# VERCEL_OIDC_TOKEN=
# Optional: a read replica API URL; reads go there, writes to the primary.
# SUPABASE_READ_URL=
# Workflows (/workflows): the Workflow SDK runs on the Supabase World. Server-only.
WORKFLOW_TARGET_WORLD=better-supabase/workflow-sdk/world
# The database URL (`DB_URL` in `supabase status --env`); on Vercel, the pooler
# URL in session mode. The developer settings (webhooks, jobs, signing keys)
# read module tables over the same connection.
WORKFLOW_POSTGRES_URL=
# Optional: "pg_net" delivers steps from the database instead of the dev poller.
# WORKFLOW_DELIVERY=
# WORKFLOW_DELIVERY_SECRET=
# Optional: a base64 32-byte master key; each run's data is encrypted with a key derived from it.
# WORKFLOW_ENCRYPTION_KEY=
# Optional: the flow route the World posts steps to; defaults to localhost:$PORT.
# WORKFLOW_FLOW_URL=
# Optional: a prefix for queue names, so two apps can share one database.
# WORKFLOW_QUEUE_NAMESPACE=
# Optional, build time: source maps for the workflow bundles (true, inline,
# linked, external or both), so stack traces point at your source.
# WORKFLOW_SOURCEMAP=
# The bearer token /api/workflows/tick checks (Vercel Cron sends it).
CRON_SECRET=
# Optional, server-only: signs the precomputed pricing flags and guards Flags
# Explorer (/.well-known/vercel/flags). Generate one with
# `node -e "console.log(crypto.randomBytes(32).toString('base64url'))"`.
# FLAGS_SECRET=
# Optional, e2e only: a directory cache-handlers/shared-remote.ts keeps the
# `"use cache: remote"` entries in, so two `next start` instances share them.
# BSB_REMOTE_CACHE_DIR=
