NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: the VAPID public key for web push (the push card in Preferences).
# Generate a key pair with `npx web-push generate-vapid-keys`.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server-only, never NEXT_PUBLIC_: account deletion (bs.deleteAccount) and the
# shared plan catalog (bs.admin()) use it.
SUPABASE_SECRET_KEY=
# Optional: the /assistant sample answers with a scripted model without it.
# AI_GATEWAY_API_KEY=
# Optional: a read replica API URL; reads go there, writes to the primary.
# SUPABASE_READ_URL=
# Testing only: every Supabase request from the server waits this many ms.
# BS_FETCH_DELAY_MS=
# Workflows (/workflows): the Workflow SDK runs on the Supabase World. Server-only.
WORKFLOW_TARGET_WORLD=better-supabase/workflow-sdk/world
# The database URL (`DB_URL` in `supabase status --env`); on Vercel, the pooler
# URL in session mode. The developer settings (webhooks, jobs, signing keys)
# read module tables over the same connection.
WORKFLOW_POSTGRES_URL=
# Optional: "pg_net" delivers steps from the database instead of the dev poller.
# WORKFLOW_DELIVERY=
# WORKFLOW_DELIVERY_SECRET=
# Optional: a base64 32-byte master key; each run's data is encrypted with a key derived from it.
# WORKFLOW_ENCRYPTION_KEY=
# The bearer token /api/workflows/tick checks (Vercel Cron sends it).
CRON_SECRET=
# Optional, server-only: signs the precomputed pricing flags and guards Flags
# Explorer (/.well-known/vercel/flags). Generate one with
# `node -e "console.log(crypto.randomBytes(32).toString('base64url'))"`.
# FLAGS_SECRET=
