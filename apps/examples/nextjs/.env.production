# Public values so `next build` works without a stack. The CLI picks the local
# stack's ports for each checkout, so the environment overrides the URL:
# `pnpm env:local` writes it, and the e2e config reads it from supabase status.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
