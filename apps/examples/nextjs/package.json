{
  "name": "@better-supabase/example-nextjs",
  "version": "0.0.0",
  "private": true,
  "description": "A Next.js App Router app: Cache Components, instant navigation, role-aware menus, proxy session refresh, route handlers and actions.",
  "type": "module",
  "exports": {
    "./supabase": "./src/lib/supabase.ts"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev -p 3100",
    "dev:portless": "portless run --force --name example next dev",
    "doctor": "better-supabase doctor",
    "doctor:explain": "better-supabase doctor --only BS205,BS206,BS207 --explain customers,notes --claims '{\"role\":\"authenticated\",\"org_id\":\"00000000-0000-4000-8000-000000000001\"}'",
    "gen": "better-supabase gen",
    "gen:check": "better-supabase gen --check",
    "lint": "oxlint",
    "start": "next start -p 3100",
    "typecheck": "next typegen && tsc --noEmit --checkers 4"
  },
  "dependencies": {
    "@supabase/server": "catalog:",
    "@supabase/ssr": "catalog:",
    "@supabase/supabase-js": "catalog:",
    "@tanstack/react-query": "catalog:",
    "better-result": "catalog:",
    "better-supabase": "workspace:*",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "server-only": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@better-supabase/ox-config": "workspace:*",
    "@better-supabase/typescript-config": "workspace:*",
    "@supabase/middleware": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "oxlint": "catalog:",
    "portless": "catalog:",
    "typescript": "catalog:"
  }
}
