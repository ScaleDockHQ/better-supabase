{
  "$schema": "https://v2-11-7.turborepo.dev/schema.json",
  "extends": ["//"],
  "tags": ["example"],
  "tasks": {
    "dev": {
      "passThroughEnv": [
        "AI_GATEWAY_API_KEY",
        "APP_URL",
        "CRON_SECRET",
        "INBOX_BOT_SECRET",
        "SUPABASE_*",
        "WORKFLOW_*"
      ]
    },
    "typecheck": {
      "dependsOn": ["$TURBO_EXTENDS$", "^build"]
    },
    "dev:portless": {
      "passThroughEnv": [
        "AI_GATEWAY_API_KEY",
        "APP_URL",
        "CRON_SECRET",
        "INBOX_BOT_SECRET",
        "SUPABASE_*",
        "WORKFLOW_*"
      ]
    }
  }
}
