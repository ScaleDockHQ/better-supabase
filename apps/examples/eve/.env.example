# The browser signs in with these and sends the access token to the agent.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The agent verifies sessions against the same project.
SUPABASE_URL=http://127.0.0.1:55421
SUPABASE_PUBLISHABLE_KEY=
# Server-only, never NEXT_PUBLIC_: the agent's hooks, memory and connections
# run as the service role.
SUPABASE_SECRET_KEY=
# The Supabase World and the jobs drain connect here (the local stack listens
# on 127.0.0.1:55422); on Vercel, the pooler URL in session mode.
SUPABASE_DB_URL=
# The model, through the AI Gateway.
AI_GATEWAY_API_KEY=
# The bearer token /api/jobs/drain checks (Vercel Cron sends it).
CRON_SECRET=
# The shared secret the drain route sends to the inbox channel at /eve/v1/inbox.
INBOX_BOT_SECRET=
# Where the drain route reaches the app, without a trailing slash.
APP_URL=http://localhost:3110
