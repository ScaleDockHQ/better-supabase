{
  "name": "@better-supabase/example-expo-powersync",
  "version": "0.0.0",
  "private": true,
  "description": "An Expo Router app: web reads through PostgREST in server loaders, iOS and Android read the PowerSync database, with one list definition.",
  "type": "module",
  "main": "expo-router/entry",
  "exports": {
    "./lists": "./src/lists.ts"
  },
  "scripts": {
    "dev": "expo start",
    "gen": "better-supabase gen",
    "gen:check": "better-supabase gen --check",
    "lint": "oxlint",
    "transit": "true",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/log-box": "catalog:",
    "@expo/metro-runtime": "catalog:",
    "@op-engineering/op-sqlite": "catalog:",
    "@powersync/common": "catalog:",
    "@powersync/react-native": "catalog:",
    "@supabase/server": "catalog:",
    "@supabase/ssr": "catalog:",
    "@supabase/supabase-js": "catalog:",
    "better-supabase": "workspace:*",
    "expo": "catalog:",
    "expo-constants": "catalog:",
    "expo-linking": "catalog:",
    "expo-router": "catalog:",
    "expo-secure-store": "catalog:",
    "expo-server": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-screens": "catalog:",
    "react-native-web": "catalog:",
    "temporal-polyfill": "catalog:"
  },
  "devDependencies": {
    "@better-supabase/ox-config": "workspace:*",
    "@better-supabase/typescript-config": "workspace:*",
    "@react-native/metro-config": "catalog:",
    "@types/react": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
