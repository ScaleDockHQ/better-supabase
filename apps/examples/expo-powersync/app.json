{
  "expo": {
    "name": "better-supabase example",
    "slug": "better-supabase-expo-powersync",
    "scheme": "bsexample",
    "web": {
      "bundler": "metro",
      "output": "server"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app",
          "unstable_useServerDataLoaders": true,
          "unstable_useServerMiddleware": true,
          "unstable_useServerRendering": true
        }
      ],
      "expo-secure-store",
      "expo-notifications"
    ],
    "updates": {
      "enabled": false
    }
  }
}
