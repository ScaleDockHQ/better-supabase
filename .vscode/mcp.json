{
  "servers": {
    "better-supabase-docs": {
      "type": "http",
      "url": "https://bettersupabase.com/mcp"
    },
    "vercel": { "type": "http", "url": "https://mcp.vercel.com" },
    "shadcn": {
      "type": "stdio",
      "command": "pnpm",
      "args": ["--dir", "apps/marketing", "exec", "shadcn", "mcp"]
    },
    "reui": {
      "type": "http",
      "url": "https://mcp.reui.io",
      "headers": { "Authorization": "Bearer ${env:REUI_LICENSE_KEY}" }
    }
  }
}
