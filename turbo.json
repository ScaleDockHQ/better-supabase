{
  "$schema": "https://v2-11-5.turborepo.dev/schema.json",
  "futureFlags": {
    "globalConfiguration": true
  },
  "global": {
    "env": ["CI", "NODE_ENV"],
    "envMode": "strict",
    "inputs": ["tsconfig.json", "packages/typescript-config/*.json"],
    "passThroughEnv": ["LEFTHOOK"],
    "remoteCache": {
      "teamSlug": "scaledock",
      "signature": false
    }
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build", "^build"]
    },
    "check:publish": {
      "dependsOn": ["build", "^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
