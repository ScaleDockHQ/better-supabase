{
  "$schema": "https://v2-11-5.turborepo.dev/schema.json",
  "futureFlags": {
    "affectedUsingTaskInputs": true
  },
  "envMode": "strict",
  "globalEnv": ["CI", "NODE_ENV"],
  "globalPassThroughEnv": [
    "SUPABASE_*",
    "VERCEL_*",
    "VERCEL",
    "PORTLESS*",
    "REUI_LICENSE_KEY",
    "GITHUB_ACTIONS",
    "LEFTHOOK"
  ],
  "globalDependencies": [
    "tsconfig.json",
    "oxlint.config.ts",
    "oxfmt.config.ts",
    "packages/typescript-config/*.json"
  ],
  "remoteCache": {
    "teamSlug": "scaledock",
    "signature": false
  },
  "boundaries": {
    "tags": {
      "published": {
        "dependencies": {
          "deny": ["app", "example", "test"]
        }
      },
      "app": {
        "dependents": {
          "deny": ["published", "config", "example"]
        }
      },
      "example": {
        "dependents": {
          "deny": ["published", "config", "app"]
        }
      },
      "test": {
        "dependents": {
          "deny": ["published", "config", "app", "example"]
        }
      }
    }
  },
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        ".source/**"
      ]
    },
    "lint": {
      "dependsOn": ["^build", "transit"]
    },
    "typecheck": {
      "dependsOn": ["^build", "transit"]
    },
    "test": {
      "dependsOn": ["build", "^build"]
    },
    "check:publish": {
      "dependsOn": ["build", "^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:portless": {
      "cache": false,
      "persistent": true
    }
  }
}
