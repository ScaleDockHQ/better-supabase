{
  "$schema": "https://v2-11-6.turborepo.dev/schema.json",
  "futureFlags": {
    "affectedUsingTaskInputs": true,
    "filterUsingTasks": true,
    "watchUsingTaskInputs": true,
    "pruneIncludesGlobalFiles": true,
    "githubActionsRemoteBaseRefFallback": true,
    "errorsOnlyShowHash": true,
    "longerSignatureKey": true
  },
  "envMode": "strict",
  "cacheMaxAge": "14d",
  "cacheMaxSize": "10GB",
  "globalEnv": ["CI", "NODE_ENV", "EXPOSE_TESTING_API"],
  "globalPassThroughEnv": [
    "SUPABASE_*",
    "VERCEL_*",
    "VERCEL",
    "PORTLESS*",
    "REUI_LICENSE_KEY",
    "GITHUB_ACTIONS",
    "LEFTHOOK",
    "TURBO_REMOTE_CACHE_SIGNATURE_KEY"
  ],
  "globalDependencies": [
    "tsconfig.json",
    "oxlint.config.ts",
    "oxfmt.config.ts",
    "pnpm-workspace.yaml",
    "packages/typescript-config/**",
    "packages/ox-config/**"
  ],
  "remoteCache": {
    "teamSlug": "scaledock",
    "signature": true
  },
  "boundaries": {
    "tags": {
      "published": {
        "dependencies": {
          "deny": ["app", "example", "test"]
        }
      },
      "app": {
        "dependents": {
          "deny": ["published", "config", "tooling", "app", "example"]
        }
      },
      "example": {
        "dependents": {
          "deny": ["published", "config", "tooling", "app"]
        }
      },
      "test": {
        "dependents": {
          "deny": ["published", "config", "tooling", "app", "example"]
        }
      }
    }
  },
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        ".source/**"
      ]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "//#lint:root": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!apps/**",
        "!packages/**",
        "!tests/**",
        "!supabase/**",
        "!docs/**"
      ]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "check:publish": {
      "dependsOn": ["build", "^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:portless": {
      "cache": false,
      "persistent": true
    },
    "analyze": {
      "cache": false,
      "persistent": true
    }
  }
}
